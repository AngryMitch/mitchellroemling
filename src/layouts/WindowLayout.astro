---
import BaseLayout from './BaseLayout.astro';
import Window from '../components/Window.astro';

/**
 * A content page presented as a window on the desktop.
 *
 * The window is emitted bare into BaseLayout's #window-host. On desktops
 * desktop.ts positions and sizes it; on phones (and with JS off) it just flows
 * as a full-width block, which is what the site did before.
 */
interface Props {
  title: string;
  windowTitle: string;
  description?: string;
  icon?: string;
  ogImage?: string;
  noindex?: boolean;
  /** Extra class on <body>; desktop.ts keeps `is-home` in sync after that. */
  bodyClass?: string;
}
const { title, windowTitle, description, icon, ogImage, noindex, bodyClass } =
  Astro.props;

const hasMenu = Astro.slots.has('menubar');
const hasStatus = Astro.slots.has('statusbar');
---

<BaseLayout
  title={title}
  description={description}
  ogImage={ogImage}
  noindex={noindex}
  bodyClass={bodyClass}
>
  <Window title={windowTitle} icon={icon} closeHref="/">
    {hasMenu && <Fragment slot="menubar"><slot name="menubar" /></Fragment>}
    <slot />
    {hasStatus && <Fragment slot="statusbar"><slot name="statusbar" /></Fragment>}
  </Window>
</BaseLayout>
