---
import '../styles/global.css';
import Taskbar from '../components/Taskbar.astro';
import MusicPlayer from '../components/MusicPlayer.astro';
import DesktopShortcuts from '../components/DesktopShortcuts.astro';
import ArtworkViewer from '../components/ArtworkViewer.astro';
import { SITE } from '../consts';

/**
 * The HTML shell shared by every page: <head> meta, fonts, the desktop
 * wallpaper, the window host, the Taskbar and the music player.
 *
 * Every page still renders standalone (crawlers and no-JS visitors get the full
 * thing). Once scripts/desktop.ts boots it takes over navigation: links are
 * intercepted and the target page's window is fetched into #window-host, so the
 * document — and with it the music player's iframe — never reloads.
 */
interface Props {
  title: string;
  description?: string;
  /** Path to an OG image under /public, optional. */
  ogImage?: string;
  /** Hide the taskbar (used by the full-screen BSOD 404). */
  chrome?: boolean;
  /** Extra class on <body> (e.g. "is-desktop"). */
  bodyClass?: string;
  /** Keep this page out of search engines (e.g. the .family corner). */
  noindex?: boolean;
}
const {
  title,
  description = SITE.description,
  ogImage = '/og-default.svg',
  chrome = true,
  bodyClass,
  noindex = false,
} = Astro.props;

const pageTitle = title === SITE.name ? title : `${title} - ${SITE.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? SITE.url).href;
const ogImageUrl = new URL(ogImage, Astro.site ?? SITE.url).href;
---

<!doctype html>
<html lang={SITE.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />

    <!-- Restore "family mode" before paint (no flash) if unlocked this session. -->
    <script is:inline>
      try {
        if (sessionStorage.getItem('mr:family') === '1')
          document.documentElement.classList.add('family-mode');
      } catch (e) {}
    </script>

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#f8f1e4" />
    <meta name="generator" content={Astro.generator} />

    <!-- Open Graph / Twitter -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- One rounded sans for the whole site; small labels use the system mono. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800&display=swap"
    />

    <link rel="sitemap" href="/sitemap-index.xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${SITE.name} - Blog`}
      href="/rss.xml"
    />

  </head>
  <body
    class:list={['app', bodyClass, { 'no-chrome': !chrome }]}
    data-site-name={SITE.name}
  >
    <a class="skip-link" href="#main">Skip to content</a>
    {chrome && <DesktopShortcuts />}
    <main id="main" class="app-main">
      <div id="window-host" class="window-host">
        <slot />
      </div>
    </main>
    {chrome && <Taskbar />}
    {chrome && <MusicPlayer />}
    {chrome && <ArtworkViewer />}

    {chrome && <script>import '../scripts/desktop.ts';</script>}

    <style>
      .app {
        position: relative;
        min-height: 100vh;
        min-height: 100dvh;
        /* Warm paper wallpaper with a few soft colour blooms. Pure CSS, so
           there's no asset to download and nothing copyrighted. */
        background-color: #fdf3e3;
        background-image:
          radial-gradient(90% 55% at 10% 4%, rgba(255, 214, 165, 0.6), transparent 62%),
          radial-gradient(80% 55% at 92% 2%, rgba(178, 213, 235, 0.45), transparent 62%),
          radial-gradient(120% 80% at 50% 108%, rgba(255, 223, 190, 0.75), transparent 66%),
          linear-gradient(165deg, #fff7ea 0%, #fdeedd 52%, #f6e5d2 100%);
        background-attachment: fixed;
      }
      .app-main {
        position: relative;
        z-index: 2;
        /* Clicks fall through to the wallpaper and its icons; only windows
           themselves catch them (re-enabled on .window below). */
        pointer-events: none;
        min-height: 100vh;
        min-height: 100dvh;
        padding-bottom: calc(var(--taskbar-gap) + 1rem);
      }
      .app-main :global(.window) {
        pointer-events: auto;
      }
      .app.no-chrome .app-main {
        padding-bottom: 0;
      }

      /* Desktops: the host is the canvas windows float on, sized to the area
         above the taskbar. desktop.ts positions each window inside it. */
      @media (min-width: 768px) {
        .window-host {
          position: fixed;
          inset: 0 0 var(--taskbar-gap) 0;
          z-index: 2;
        }
        .window-host :global(.window) {
          position: absolute;
          overflow: hidden;
          /* Relative to the host, so the cap follows viewport changes on its
             own. desktop.ts keeps --win-top in step with the window's offset. */
          max-height: calc(100% - var(--win-top, 12px) - 12px);
        }
        /* Windows scroll internally instead of growing the page. */
        .window-host :global(.window-body) {
          overflow: auto;
          min-height: 0;
        }
        .window-host :global(.window.is-maximised) {
          inset: 0 !important;
          width: auto !important;
          height: auto !important;
          max-height: none !important;
        }
        .window-host :global(.window.is-dragging) {
          user-select: none;
          cursor: grabbing;
          box-shadow: var(--shadow-lift);
        }
        .window-host :global(.window.is-dragging .title-bar) {
          cursor: grabbing;
        }
        .window-host :global(.window .title-bar) {
          cursor: grab;
        }
        .window-host :global(.window.is-minimized) {
          display: none;
        }
      }

      /* Phones: one window at a time in normal flow, and the desktop icons sit
         under it on the home window only — exactly how the site behaved before. */
      @media (max-width: 767px) {
        .app {
          display: flex;
          flex-direction: column;
        }
        .app .app-main {
          order: 0;
          min-height: 0;
          padding-bottom: 0;
        }
        /* WindowLayout no longer supplies its own container, so the gutter
           lives here where both phone and desktop layouts can see it.
           The bottom gap clears the fixed taskbar *and* the collapsed music
           pill above it, so a window's last row of buttons stays tappable. */
        .window-host {
          padding: clamp(0.5rem, 3vw, 1rem) clamp(0.625rem, 3vw, 2rem)
            calc(var(--taskbar-gap) + 4.5rem);
        }
        /* On the home window the icon grid follows and carries that gap
           itself, so the window doesn't need to reserve it twice. */
        .app.is-home .window-host {
          padding-bottom: 1rem;
        }
        .app :global(.desktop-shortcuts) {
          display: none;
        }
        .app.is-home :global(.desktop-shortcuts) {
          display: grid;
          order: 1;
          position: static;
          /* Extra room so the collapsed music pill never lands on an icon. */
          padding-bottom: calc(var(--taskbar-gap) + 4.5rem);
        }
        .window-host :global(.window.is-minimized) {
          display: none;
        }
      }
    </style>
  </body>
</html>
