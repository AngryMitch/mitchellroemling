---
import WindowLayout from '../layouts/WindowLayout.astro';

/**
 * The blue-screen joke, contained in a window instead of taking over the whole
 * screen. The old version rendered with chrome={false}, which meant no taskbar,
 * no music player and a full document load — a dead end that silenced the music.
 * A crash dialog sitting on an otherwise tidy desktop is funnier anyway.
 */
---

<WindowLayout
  title="Fatal Exception"
  windowTitle="Fatal Exception"
  icon="/icons/computer.svg"
  description="That page could not be found."
  noindex={true}
>
  <div class="bsod" role="alertdialog" aria-label="Page not found error">
    <pre class="art" aria-hidden="true">  (x_x)</pre>
    <p class="head"><span class="inv">Windows</span></p>
    <p>
      A fatal exception <strong>0E</strong> has occurred at
      <strong>0028:0x00000404</strong> : <strong>PAGE_NOT_FOUND</strong>.
      The current request has been terminated.
    </p>
    <p>* The page you requested could not be located on this desktop.</p>
    <p>* It may have been moved, deleted, or never existed.</p>
    <br />
    <p>* Close this window, or <a href="/">go back to the desktop</a>.</p>
    <br />
    <p class="blink">_</p>
  </div>

  <Fragment slot="statusbar">
    <span class="status-cell">0x00000404</span>
    <span class="status-cell grow">Not found</span>
  </Fragment>
</WindowLayout>

<style>
  /* Bleed the blue to the window body's edges, so it reads as a crashed app
     rather than a blue box floating inside a cream one. */
  .bsod {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: clamp(1.25rem, 4vw, 2rem);
    margin: calc(var(--body-pad, clamp(0.9rem, 4vw, 1.75rem)) * -1);
    border-radius: var(--radius-sm);
    background: linear-gradient(165deg, #6d8fb4 0%, #5b7fa8 55%, #4e6f95 100%);
    color: rgba(255, 255, 255, 0.92);
    font-family: var(--font-mono);
    font-size: clamp(0.82rem, 2.4vw, 0.95rem);
    line-height: 1.75;
    overflow-wrap: anywhere;
  }
  .art {
    font-family: var(--font-mono);
    font-size: 2rem;
    margin-bottom: 1rem;
    opacity: 0.85;
  }
  .head {
    text-align: center;
    margin-bottom: 1.25rem;
  }
  .inv {
    background: rgba(255, 255, 255, 0.9);
    color: #4e6f95;
    padding: 4px 14px;
    border-radius: var(--radius-pill);
    font-family: var(--font-chrome);
    font-weight: 800;
  }
  .bsod a {
    color: #fff;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .bsod strong {
    color: #fff;
  }
  .blink {
    animation: blink 1.1s step-end infinite;
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .blink {
      animation: none;
    }
  }
</style>
