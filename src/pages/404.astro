---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Fatal Exception" chrome={false} bodyClass="bsod-body">
  <div class="bsod" role="alertdialog" aria-label="Page not found error">
    <pre class="art" aria-hidden="true">  (x_x)</pre>
    <p class="head"><span class="inv">Windows</span></p>
    <p>
      A fatal exception <strong>0E</strong> has occurred at
      <strong>0028:0x00000404</strong> : <strong>PAGE_NOT_FOUND</strong>.
      The current request has been terminated.
    </p>
    <p>* The page you requested could not be located on this desktop.</p>
    <p>* It may have been moved, deleted, or never existed.</p>
    <br />
    <p>* Press any key to return to the desktop.</p>
    <p>* Or click <a href="/">here</a> to continue.</p>
    <br />
    <p class="blink">Press any key to continue _</p>
  </div>
</BaseLayout>

<style is:global>
  /* The <body> itself carries the `.app` class, so target it directly. */
  body.bsod-body {
    background: var(--bsod-blue) !important;
  }
  body.bsod-body .app-main {
    padding-bottom: 0;
  }
</style>

<style>
  .bsod {
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.4rem;
    max-width: 760px;
    margin: 0 auto;
    padding: 2rem 1.25rem;
    color: #fff;
    font-family: var(--font-mono);
    font-size: clamp(0.9rem, 2.5vw, 1.05rem);
    line-height: 1.6;
  }
  .art {
    font-family: var(--font-mono);
    font-size: 2rem;
    margin-bottom: 1rem;
  }
  .head {
    text-align: center;
    margin-bottom: 1.25rem;
  }
  .inv {
    background: #aaa;
    color: var(--bsod-blue);
    padding: 0 10px;
    font-weight: bold;
  }
  .bsod a {
    color: #fff;
    text-decoration: underline;
  }
  strong {
    color: #fff;
  }
  .blink {
    margin-top: 1rem;
    animation: blink 1.1s step-end infinite;
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .blink {
      animation: none;
    }
  }
</style>

<script>
  // Press any key — or tap anywhere — to return to the desktop.
  const goHome = () => (window.location.href = '/');
  document.addEventListener('keydown', goHome, { once: true });
  document.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).tagName !== 'A') goHome();
  });
</script>
