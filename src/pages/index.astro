---
import WindowLayout from '../layouts/WindowLayout.astro';
import { SITE } from '../consts';

/**
 * The desktop's home window. It was already drawn to look like a little
 * Notepad window, so now it simply *is* one — same chrome, same controls and
 * same taskbar button as every other window.
 */
---

<WindowLayout
  title={SITE.name}
  windowTitle="Welcome.txt"
  icon="/icons/computer.svg"
  description={SITE.description}
  bodyClass="is-home"
>
  <div class="welcome-body">
    <p class="hi">hi! i'm {SITE.name.split(' ')[0]}</p>
    <p class="role">{SITE.tagline}</p>
    <p>
      This is my corner of the web, dressed up like a cosy little desktop.
      Open an icon to wander through my artwork, code projects, and
      writing, or hit <strong>Start</strong> down in the corner.
    </p>
    <p class="tip">
      Everything opens in its own window, so you can keep a few things going
      at once — and the music keeps playing wherever you wander.
    </p>
  </div>

  <Fragment slot="statusbar">
    <span class="status-cell">Ready</span>
    <span class="status-cell grow">{SITE.name}</span>
  </Fragment>
</WindowLayout>

<style>
  .welcome-body {
    font-family: var(--font-body);
    line-height: 1.7;
    color: var(--ink);
    max-width: 46ch;
  }
  .hi {
    font-size: 1.65rem;
    font-weight: 800;
    line-height: 1.2;
  }
  .role {
    margin-top: 2px;
    margin-bottom: 14px;
    color: var(--accent-2);
    font-weight: 700;
  }
  .welcome-body p + p {
    margin-top: 0.9rem;
  }
  .tip {
    font-size: 0.95rem;
    color: var(--ink-soft);
  }
</style>
