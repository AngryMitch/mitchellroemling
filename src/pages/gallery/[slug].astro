---
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import { Image } from 'astro:assets';
import WindowLayout from '../../layouts/WindowLayout.astro';
import Button from '../../components/Button.astro';

export const getStaticPaths = (async () => {
  const items = (
    await getCollection('artwork', ({ data }) => !data.draft && !data.hidden)
  ).sort(
    (a, b) => b.data.date.getTime() - a.data.date.getTime(),
  );
  return items.map((entry, i) => ({
    params: { slug: entry.id },
    props: {
      entry,
      prev: items[i - 1] ?? null,
      next: items[i + 1] ?? null,
    },
  }));
}) satisfies GetStaticPaths;

const { entry, prev, next } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);

const dateStr = data.date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<WindowLayout
  title={data.title}
  windowTitle={`${data.title} - Image Viewer`}
  icon="/icons/artwork.svg"
  description={data.description}
>
  <article class="artwork">
    <figure class="stage well">
      <Image
        src={data.image}
        alt={data.title}
        widths={[480, 800, 1200]}
        sizes="(max-width: 800px) 100vw, 760px"
        class="full"
      />
    </figure>

    <div class="meta">
      <h1 class="title">{data.title}</h1>
      <dl class="facts">
        <div><dt>Type</dt><dd>{data.type}</dd></div>
        {data.medium && <div><dt>Medium</dt><dd>{data.medium}</dd></div>}
        <div><dt>Date</dt><dd>{dateStr}</dd></div>
      </dl>
      <p class="desc prose">{data.description}</p>

      {
        data.tags.length > 0 && (
          <ul class="tags">
            {data.tags.map((t) => (
              <li class="tag">#{t}</li>
            ))}
          </ul>
        )
      }
    </div>

    <div class="prose body">
      <Content />
    </div>

    <nav class="pager" aria-label="Artwork navigation">
      <div class="pager-side">
        {prev && (
          <Button href={`/gallery/${prev.id}`}>‹ {prev.data.title}</Button>
        )}
      </div>
      <Button href="/gallery">▦ Back to Gallery</Button>
      <div class="pager-side right">
        {next && (
          <Button href={`/gallery/${next.id}`}>{next.data.title} ›</Button>
        )}
      </div>
    </nav>
  </article>
</WindowLayout>

<style>
  .artwork {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .stage {
    padding: 12px;
    background: var(--paper-2);
    border-radius: var(--radius-sm);
    display: grid;
    place-items: center;
  }
  .full {
    width: auto;
    max-width: 100%;
    height: auto;
    max-height: 70vh;
    object-fit: contain;
    border-radius: var(--radius-xs);
  }
  .title {
    font-family: var(--font-body);
    font-size: 1.8rem;
    font-weight: 800;
    line-height: 1.2;
  }
  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin: 0.9rem 0;
  }
  .facts div {
    display: flex;
    gap: 0.5rem;
    align-items: baseline;
  }
  .facts dt {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--ink-soft);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .facts dd {
    font-family: var(--font-ui);
    font-weight: 600;
    text-transform: capitalize;
  }
  .desc {
    max-width: none;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    list-style: none;
    padding: 0;
    margin-top: 0.9rem;
  }
  .tag {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--ink-soft);
    padding: 4px 11px;
    background: var(--paper-2);
    border-radius: var(--radius-pill);
  }
  .body:empty {
    display: none;
  }
  .pager {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 10px;
    margin-top: 1rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
  }
  .pager-side {
    display: flex;
    min-width: 0;
  }
  .pager-side.right {
    justify-content: flex-end;
  }
  /* Long neighbour titles must not stretch the pager wider than the window. */
  .pager :global(.btn) {
    max-width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    display: inline-block;
    line-height: var(--tap);
    padding-block: 0;
  }
  @media (max-width: 560px) {
    .title {
      font-size: 1.5rem;
    }
    .stage {
      padding: 8px;
    }
    .pager {
      grid-template-columns: 1fr;
      gap: 8px;
    }
    .pager-side.right {
      justify-content: flex-start;
    }
    .pager :global(.btn) {
      width: 100%;
      text-align: center;
    }
  }
</style>
