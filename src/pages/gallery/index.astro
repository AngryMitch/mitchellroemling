---
import { getCollection } from 'astro:content';
import WindowLayout from '../../layouts/WindowLayout.astro';
import ArtworkCard from '../../components/ArtworkCard.astro';
import MenuBar from '../../components/MenuBar.astro';
import { ARTWORK_TYPES } from '../../consts';

const artworks = (
  await getCollection('artwork', ({ data }) => !data.draft && !data.hidden)
).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

const counts = {
  all: artworks.length,
  ...Object.fromEntries(
    ARTWORK_TYPES.map((t) => [t, artworks.filter((a) => a.data.type === t).length]),
  ),
} as Record<string, number>;
---

<WindowLayout
  title="Artwork"
  windowTitle="My Artwork"
  icon="/icons/artwork.svg"
  description="My gallery of mixed-media artwork: digital, traditional, and photography."
>
  <MenuBar slot="menubar" />

  <div class="gallery">
    <div class="toolbar" role="toolbar" aria-label="Filter artwork by type">
      <button class="filter font-chrome is-active" data-filter="all" aria-pressed="true">
        All <span class="count">({counts.all})</span>
      </button>
      {
        ARTWORK_TYPES.map((t) => (
          <button class="filter font-chrome" data-filter={t} aria-pressed="false">
            {t} <span class="count">({counts[t] ?? 0})</span>
          </button>
        ))
      }
    </div>

    {
      artworks.length === 0 ? (
        <p class="empty prose">
          No artwork yet. Add a Markdown file to{' '}
          <code>src/content/artwork/</code> to populate this gallery.
        </p>
      ) : (
        <div class="grid" id="art-grid">
          {artworks.map((entry) => (
            <ArtworkCard entry={entry} />
          ))}
        </div>
      )
    }
    <p class="no-results prose" hidden>No artwork matches that filter.</p>
  </div>

  <Fragment slot="statusbar">
    <span class="status-cell"><span id="shown-count">{counts.all}</span> object(s)</span>
    <span class="status-cell grow">My Artwork</span>
  </Fragment>
</WindowLayout>

<style>
  /* Scrolls sideways on a phone instead of wrapping into four ragged rows. */
  .toolbar {
    display: flex;
    gap: 8px;
    padding-bottom: 16px;
    margin-bottom: 16px;
    border-bottom: 1px solid var(--line);
    overflow-x: auto;
    scrollbar-width: none;
  }
  .toolbar::-webkit-scrollbar {
    display: none;
  }
  .filter {
    flex: none;
    min-height: 38px;
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: capitalize;
    padding: 6px 16px;
    color: var(--ink-soft);
    background: var(--paper-2);
    border: 1px solid transparent;
    border-radius: var(--radius-pill);
    transition: background var(--transition), color var(--transition);
  }
  .filter:hover {
    background: var(--accent-soft);
    color: var(--ink);
  }
  .filter.is-active {
    background: var(--accent);
    border-color: var(--accent-2);
    color: #fff;
  }
  .count {
    font-weight: 400;
    opacity: 0.7;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
    gap: 10px;
  }
  .empty,
  .no-results {
    padding: 1.5rem 0;
  }
  @media (max-width: 520px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 8px;
    }
  }
</style>

<script>
  function initGalleryFilters() {
    const filters = Array.from(document.querySelectorAll<HTMLButtonElement>('.filter'));
    const cards = Array.from(document.querySelectorAll<HTMLElement>('.art-card'));
    const shownCount = document.getElementById('shown-count');
    const noResults = document.querySelector<HTMLElement>('.no-results');
    if (filters.length === 0) return;

    const apply = (type: string) => {
      let shown = 0;
      cards.forEach((card) => {
        const match = type === 'all' || card.dataset.type === type;
        card.style.display = match ? '' : 'none';
        if (match) shown++;
      });
      if (shownCount) shownCount.textContent = String(shown);
      if (noResults) noResults.hidden = shown !== 0;
    };

    filters.forEach((btn) => {
      if (btn.dataset.galleryFilterReady) return;
      btn.dataset.galleryFilterReady = 'true';
      btn.addEventListener('click', () => {
        filters.forEach((b) => {
          b.classList.remove('is-active');
          b.setAttribute('aria-pressed', 'false');
        });
        btn.classList.add('is-active');
        btn.setAttribute('aria-pressed', 'true');
        apply(btn.dataset.filter ?? 'all');
      });
    });
  }

  if (!(window as any).__mrGalleryFilters) {
    (window as any).__mrGalleryFilters = true;
    document.addEventListener('astro:page-load', initGalleryFilters);
  }
  initGalleryFilters();
</script>
