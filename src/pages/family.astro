---
import BaseLayout from '../layouts/BaseLayout.astro';
import Window from '../components/Window.astro';
import Button from '../components/Button.astro';
import encData from '../generated/family.enc.json';

// The page only ever ships ciphertext (`encData`). The plaintext gift list and
// the passcode live nowhere in the build — see docs/family-corner-plan.md.
// noindex + excluded from the sitemap so it stays out of search engines.
---

<BaseLayout
  title=".family"
  description="A private corner for friends & family."
  noindex={true}
>
  <div class="family-page container">
    <Window title=".family" icon="/icons/family-locked.svg" closeHref="/">
      <!-- Locked gate -->
      <div id="family-locked" class="locked">
        <div class="lock-hero" aria-hidden="true">🔒</div>
        <h1 class="lock-title font-chrome">This folder is locked</h1>
        <p class="lock-text">
          A private corner for friends &amp; family. Enter the passcode to open
          it — the contents are encrypted, so there's nothing to peek at without
          the code.
        </p>
        <form id="unlock-form" class="unlock-form" autocomplete="off">
          <label class="sr-only" for="passcode-input">Family passcode</label>
          <input
            id="passcode-input"
            class="passcode-input bevel-sunken"
            type="password"
            inputmode="text"
            placeholder="passcode"
            autocomplete="off"
            spellcheck="false"
          />
          <Button type="submit">Unlock</Button>
        </form>
        <p id="unlock-error" class="error" role="alert" hidden>
          ✖ Wrong passcode. Try again.
        </p>
        <p id="unlock-working" class="working" hidden>Decrypting…</p>
      </div>

      <!-- Unlocked corner (revealed client-side after a correct passcode) -->
      <div id="family-unlocked" class="unlocked" hidden>
        <div class="explorer">
          <nav id="family-files" class="files" aria-label="Family documents"></nav>
          <article id="family-content" class="content prose"></article>
        </div>
        <div class="actions">
          <Button id="lock-btn" type="button">🔒 Lock again</Button>
          <Button href="/">‹ Back to Desktop</Button>
        </div>
      </div>

      <Fragment slot="statusbar">
        <span id="family-status" class="status-cell bevel-sunken">Locked</span>
        <span class="status-cell bevel-sunken grow">.family</span>
      </Fragment>
    </Window>
  </div>

  <!-- Encrypted payload (ciphertext only). -->
  <script
    is:inline
    type="application/json"
    id="family-cipher"
    set:html={JSON.stringify(encData)}
  />
</BaseLayout>

<style>
  .family-page {
    padding-top: clamp(0.75rem, 4vh, 2.5rem);
    padding-bottom: 2rem;
    max-width: 820px;
  }

  /* ---- Locked gate ---- */
  .locked {
    text-align: center;
    padding: 1.5rem 1rem 2rem;
    max-width: 480px;
    margin: 0 auto;
  }
  .lock-hero {
    font-size: 3rem;
    line-height: 1;
    margin-bottom: 0.75rem;
  }
  .lock-title {
    font-size: 13px;
    color: var(--win-navy);
    margin-bottom: 0.75rem;
  }
  .lock-text {
    font-family: var(--font-body);
    line-height: 1.6;
    color: #333;
    margin-bottom: 1.25rem;
  }
  .unlock-form {
    display: flex;
    gap: 8px;
    justify-content: center;
    flex-wrap: wrap;
  }
  .passcode-input {
    font-family: var(--font-ui);
    font-size: 1rem;
    padding: 7px 10px;
    min-width: 200px;
    background: var(--win-white);
  }
  .error {
    margin-top: 1rem;
    color: #b00020;
    font-family: var(--font-ui);
  }
  .working {
    margin-top: 1rem;
    font-family: var(--font-chrome);
    font-size: 9px;
    color: var(--win-navy);
  }

  /* ---- Unlocked explorer ---- */
  .explorer {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 10px;
    min-height: 320px;
  }
  .files {
    display: flex;
    flex-direction: column;
    gap: 3px;
    padding: 6px;
    background: var(--win-white);
    border: 2px solid;
    border-color: var(--win-darker) var(--win-light) var(--win-light)
      var(--win-darker);
  }
  .content {
    max-width: none;
    padding: 1rem 1.25rem;
    background: var(--win-white);
    border: 2px solid;
    border-color: var(--win-darker) var(--win-light) var(--win-light)
      var(--win-darker);
    overflow-wrap: break-word;
  }
  .actions {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    margin-top: 12px;
  }
  .status-cell {
    padding: 2px 8px;
    font-size: 0.8rem;
    font-family: var(--font-ui);
  }
  .status-cell.grow {
    flex: 1;
  }

  /* Injected file buttons (styled here since they're created in JS). */
  .files :global(.file-btn) {
    display: flex;
    align-items: center;
    gap: 8px;
    width: 100%;
    text-align: left;
    padding: 6px 8px;
    font-family: var(--font-ui);
    font-size: 0.92rem;
    background: transparent;
    border: 1px solid transparent;
    color: var(--win-text);
    cursor: pointer;
  }
  .files :global(.file-btn:hover) {
    background: #eef3fb;
  }
  .files :global(.file-btn.active) {
    background: var(--win-selection);
    color: var(--win-selection-text);
  }
  .files :global(.file-btn img) {
    width: 18px;
    height: 18px;
  }

  @media (max-width: 560px) {
    .explorer {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  type Page = { slug: string; title: string; html: string };

  const KEY_FLAG = 'mr:family';
  const KEY_PASS = 'mr:familyKey';

  const lockedEl = document.getElementById('family-locked')!;
  const unlockedEl = document.getElementById('family-unlocked')!;
  const filesEl = document.getElementById('family-files')!;
  const contentEl = document.getElementById('family-content')!;
  const statusEl = document.getElementById('family-status')!;
  const form = document.getElementById('unlock-form') as HTMLFormElement;
  const input = document.getElementById('passcode-input') as HTMLInputElement;
  const errorEl = document.getElementById('unlock-error')!;
  const workingEl = document.getElementById('unlock-working')!;
  const lockBtn = document.getElementById('lock-btn')!;
  const cipherEl = document.getElementById('family-cipher')!;

  const cfg = JSON.parse(cipherEl.textContent || '{}');
  let pages: Page[] = [];

  const b64ToBytes = (b64: string) =>
    Uint8Array.from(atob(b64), (c) => c.charCodeAt(0));

  async function decrypt(passcode: string): Promise<Page[]> {
    const salt = b64ToBytes(cfg.kdf.salt);
    const iv = b64ToBytes(cfg.cipher.iv);
    const data = b64ToBytes(cfg.data);
    const baseKey = await crypto.subtle.importKey(
      'raw',
      new TextEncoder().encode(passcode),
      'PBKDF2',
      false,
      ['deriveKey'],
    );
    const key = await crypto.subtle.deriveKey(
      { name: 'PBKDF2', salt, iterations: cfg.kdf.iterations, hash: cfg.kdf.hash },
      baseKey,
      { name: 'AES-GCM', length: 256 },
      false,
      ['decrypt'],
    );
    // Throws if the passcode is wrong (GCM auth tag fails) — that's our check.
    const buf = await crypto.subtle.decrypt({ name: 'AES-GCM', iv }, key, data);
    const payload = JSON.parse(new TextDecoder().decode(buf));
    return payload.pages as Page[];
  }

  function selectPage(i: number) {
    Array.from(filesEl.children).forEach((c, idx) =>
      c.classList.toggle('active', idx === i),
    );
    contentEl.innerHTML = pages[i].html;
  }

  function showUnlocked(loaded: Page[]) {
    pages = loaded;
    filesEl.innerHTML = '';
    pages.forEach((p, i) => {
      const btn = document.createElement('button');
      btn.className = 'file-btn';
      btn.type = 'button';
      const img = document.createElement('img');
      img.src = '/icons/blog.svg';
      img.alt = '';
      img.className = 'pixelated';
      const span = document.createElement('span');
      span.textContent = p.title;
      btn.append(img, span);
      btn.addEventListener('click', () => selectPage(i));
      filesEl.appendChild(btn);
    });
    selectPage(0);
    lockedEl.hidden = true;
    unlockedEl.hidden = false;
    statusEl.textContent = `Unlocked — ${pages.length} document(s)`;
    document.documentElement.classList.add('family-mode');
  }

  async function tryUnlock(passcode: string, remember: boolean) {
    errorEl.hidden = true;
    workingEl.hidden = false;
    try {
      const loaded = await decrypt(passcode);
      if (remember) {
        sessionStorage.setItem(KEY_FLAG, '1');
        sessionStorage.setItem(KEY_PASS, passcode);
      }
      showUnlocked(loaded);
    } catch {
      errorEl.hidden = false;
      input.select();
    } finally {
      workingEl.hidden = true;
    }
  }

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const code = input.value.trim();
    if (code) tryUnlock(code, true);
  });

  lockBtn.addEventListener('click', () => {
    sessionStorage.removeItem(KEY_FLAG);
    sessionStorage.removeItem(KEY_PASS);
    document.documentElement.classList.remove('family-mode');
    pages = [];
    contentEl.innerHTML = '';
    filesEl.innerHTML = '';
    unlockedEl.hidden = true;
    lockedEl.hidden = false;
    statusEl.textContent = 'Locked';
    input.value = '';
    input.focus();
  });

  // Already in "family mode" this session? Re-open without re-typing.
  const saved = sessionStorage.getItem(KEY_PASS);
  if (saved) tryUnlock(saved, false);
</script>
