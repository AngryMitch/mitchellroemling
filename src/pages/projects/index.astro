---
import { getCollection } from 'astro:content';
import WindowLayout from '../../layouts/WindowLayout.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import MenuBar from '../../components/MenuBar.astro';

const projects = (
  await getCollection('projects', ({ data }) => !data.draft && !data.hidden)
).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'short' });
---

<WindowLayout
  title="Projects"
  windowTitle="My Projects"
  icon="/icons/projects.svg"
  description="Coding projects — descriptions, tech stacks, and links."
>
  <MenuBar slot="menubar" />

  <div class="projects">
    {
      projects.length === 0 ? (
        <p class="empty prose">
          No projects yet. Add a Markdown file to{' '}
          <code>src/content/projects/</code> to populate this list.
        </p>
      ) : (
        <table class="explorer" id="projects-table">
          <thead>
            <tr>
              <th><button class="sort font-chrome" data-key="title">Name</button></th>
              <th class="col-desc">Description</th>
              <th class="col-tech">Tech</th>
              <th><button class="sort font-chrome" data-key="status">Status</button></th>
              <th><button class="sort font-chrome" data-key="date">Modified</button></th>
            </tr>
          </thead>
          <tbody>
            {projects.map((p) => (
              <tr
                class="row"
                tabindex="0"
                role="link"
                data-href={`/projects/${p.id}`}
                data-title={p.data.title.toLowerCase()}
                data-status={p.data.status}
                data-date={p.data.date.getTime()}
              >
                <td class="name">
                  <img src="/icons/projects.svg" alt="" class="pixelated row-icon" width="18" height="18" />
                  <a href={`/projects/${p.id}`}>{p.data.title}</a>
                  {p.data.featured && <span class="star" title="Featured">★</span>}
                </td>
                <td class="col-desc">{p.data.description}</td>
                <td class="col-tech">
                  <span class="tech">
                    {p.data.tech.slice(0, 4).map((t) => (
                      <span class="pill">{t}</span>
                    ))}
                  </span>
                </td>
                <td><StatusBadge status={p.data.status} /></td>
                <td class="date">{fmt(p.data.date)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      )
    }
  </div>

  <Fragment slot="statusbar">
    <span class="status-cell bevel-sunken">{projects.length} object(s)</span>
    <span class="status-cell bevel-sunken grow">Click a column header to sort</span>
  </Fragment>
</WindowLayout>

<style>
  .explorer {
    width: 100%;
    border-collapse: collapse;
    font-family: var(--font-ui);
    font-size: 0.9rem;
    background: var(--win-white);
  }
  .explorer thead th {
    text-align: left;
    padding: 0;
    background: var(--win-grey);
    border: 2px solid;
    border-color: var(--win-light) var(--win-dark) var(--win-dark) var(--win-light);
    white-space: nowrap;
  }
  .explorer thead th:not(:has(.sort)) {
    padding: 6px 8px;
    font-family: var(--font-chrome);
    font-size: 9px;
  }
  .sort {
    width: 100%;
    text-align: left;
    padding: 6px 8px;
    font-size: 9px;
    background: transparent;
    border: none;
    color: var(--win-text);
  }
  .sort:hover {
    background: #b5b5b5;
  }
  .sort[data-dir]::after {
    content: ' ▴';
  }
  .sort[data-dir='desc']::after {
    content: ' ▾';
  }
  .row td {
    padding: 7px 8px;
    border-bottom: 1px solid #e3e3e3;
    vertical-align: middle;
  }
  .row:nth-child(even) td {
    background: #f5f5f5;
  }
  .row:hover td,
  .row:focus-visible td {
    background: var(--win-selection);
    color: var(--win-selection-text);
  }
  .row {
    cursor: pointer;
    outline: none;
  }
  .row:focus-visible {
    outline: 1px dotted var(--win-navy);
    outline-offset: -2px;
  }
  .name {
    display: flex;
    align-items: center;
    gap: 7px;
    font-weight: bold;
    white-space: nowrap;
  }
  .name a {
    color: inherit;
    text-decoration: none;
  }
  .row:hover .name a,
  .row:focus-visible .name a {
    text-decoration: underline;
  }
  .star {
    color: #d8a200;
  }
  .row:hover .star {
    color: #ffe27a;
  }
  .tech {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
  }
  .pill {
    font-size: 0.72rem;
    padding: 1px 6px;
    background: #e9e9e9;
    border: 1px solid var(--win-dark);
    white-space: nowrap;
  }
  .row:hover .pill,
  .row:focus-visible .pill {
    color: var(--win-text);
  }
  .date {
    white-space: nowrap;
  }
  .empty {
    padding: 1.5rem 0;
  }
  .status-cell {
    padding: 2px 8px;
    font-size: 0.8rem;
    font-family: var(--font-ui);
  }
  .status-cell.grow {
    flex: 1;
  }

  /* Card layout on small screens (per PRD mobile note). */
  @media (max-width: 680px) {
    .explorer,
    .explorer tbody,
    .explorer tr,
    .explorer td {
      display: block;
      width: 100%;
    }
    .explorer thead {
      display: none;
    }
    .row {
      margin-bottom: 8px;
      border: 2px solid;
      border-color: var(--win-light) var(--win-dark) var(--win-dark) var(--win-light);
    }
    .row td {
      border-bottom: 1px solid #eee;
    }
    .col-desc,
    .col-tech {
      font-size: 0.85rem;
    }
  }
</style>

<script>
  // ---- Row navigation ----------------------------------------------------
  document.querySelectorAll<HTMLElement>('.row').forEach((row) => {
    const go = () => {
      const href = row.dataset.href;
      if (href) window.location.href = href;
    };
    row.addEventListener('click', (e) => {
      // Let real link clicks behave normally.
      if ((e.target as HTMLElement).tagName !== 'A') go();
    });
    row.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') go();
    });
  });

  // ---- Column sorting ----------------------------------------------------
  const table = document.getElementById('projects-table');
  const tbody = table?.querySelector('tbody');
  document.querySelectorAll<HTMLButtonElement>('.sort').forEach((btn) => {
    btn.addEventListener('click', () => {
      if (!tbody) return;
      const key = btn.dataset.key!;
      const dir = btn.dataset.dir === 'asc' ? 'desc' : 'asc';
      document.querySelectorAll('.sort').forEach((b) => b.removeAttribute('data-dir'));
      btn.dataset.dir = dir;

      const rows = Array.from(tbody.querySelectorAll<HTMLElement>('.row'));
      rows.sort((a, b) => {
        let av: string | number = '';
        let bv: string | number = '';
        if (key === 'date') {
          av = Number(a.dataset.date);
          bv = Number(b.dataset.date);
        } else {
          av = a.dataset[key] ?? '';
          bv = b.dataset[key] ?? '';
        }
        const cmp = av < bv ? -1 : av > bv ? 1 : 0;
        return dir === 'asc' ? cmp : -cmp;
      });
      rows.forEach((r) => tbody.appendChild(r));
    });
  });
</script>
