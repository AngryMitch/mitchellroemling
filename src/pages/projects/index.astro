---
import { getCollection } from 'astro:content';
import WindowLayout from '../../layouts/WindowLayout.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import MenuBar from '../../components/MenuBar.astro';

const projects = (
  await getCollection('projects', ({ data }) => !data.draft && !data.hidden)
).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'short' });
---

<WindowLayout
  title="Projects"
  windowTitle="My Projects"
  icon="/icons/projects.svg"
  description="My coding projects: descriptions, tech stacks, and links."
>
  <MenuBar slot="menubar" />

  <div class="projects">
    {
      projects.length === 0 ? (
        <p class="empty prose">
          No projects yet. Add a Markdown file to{' '}
          <code>src/content/projects/</code> to populate this list.
        </p>
      ) : (
        <table class="explorer" id="projects-table">
          <thead>
            <tr>
              <th><button class="sort font-chrome" data-key="title">Name</button></th>
              <th class="col-desc">Description</th>
              <th class="col-tech">Tech</th>
              <th><button class="sort font-chrome" data-key="status">Status</button></th>
              <th><button class="sort font-chrome" data-key="date">Modified</button></th>
            </tr>
          </thead>
          <tbody>
            {projects.map((p) => (
              <tr
                class="row"
                tabindex="0"
                role="link"
                data-href={`/projects/${p.id}`}
                data-title={p.data.title.toLowerCase()}
                data-status={p.data.status}
                data-date={p.data.date.getTime()}
              >
                <td class="name">
                  <img src="/icons/projects.svg" alt="" class="pixelated row-icon" width="18" height="18" />
                  <a href={`/projects/${p.id}`}>{p.data.title}</a>
                  {p.data.featured && <span class="star" title="Featured">★</span>}
                </td>
                <td class="col-desc">{p.data.description}</td>
                <td class="col-tech">
                  <span class="tech">
                    {p.data.tech.slice(0, 4).map((t) => (
                      <span class="pill">{t}</span>
                    ))}
                  </span>
                </td>
                <td><StatusBadge status={p.data.status} /></td>
                <td class="date">{fmt(p.data.date)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      )
    }
  </div>

  <Fragment slot="statusbar">
    <span class="status-cell">{projects.length} object(s)</span>
    <span class="status-cell grow">My Projects</span>
  </Fragment>
</WindowLayout>

<style>
  .explorer {
    width: 100%;
    border-collapse: collapse;
    font-family: var(--font-ui);
    font-size: 0.9rem;
  }
  .explorer thead th {
    text-align: left;
    padding: 0;
    border-bottom: 1px solid var(--line);
    white-space: nowrap;
  }
  .explorer thead th:not(:has(.sort)) {
    padding: 8px 10px;
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--ink-soft);
  }
  .sort {
    width: 100%;
    text-align: left;
    padding: 8px 10px;
    font-size: 0.78rem;
    font-weight: 700;
    background: transparent;
    border: none;
    border-radius: var(--radius-xs);
    color: var(--ink-soft);
    transition: background var(--transition), color var(--transition);
  }
  .sort:hover {
    background: var(--paper-2);
    color: var(--ink);
  }
  .sort[data-dir] {
    color: var(--accent-2);
  }
  .sort[data-dir]::after {
    content: ' ▴';
  }
  .sort[data-dir='desc']::after {
    content: ' ▾';
  }
  .row td {
    padding: 12px 10px;
    border-bottom: 1px solid var(--line);
    vertical-align: middle;
  }
  .row:hover td,
  .row:focus-visible td {
    background: var(--paper-2);
  }
  .row {
    cursor: pointer;
    outline: none;
  }
  .row:focus-visible td {
    background: var(--accent-soft);
  }
  .name {
    display: flex;
    align-items: center;
    gap: 9px;
    font-weight: 700;
    white-space: nowrap;
  }
  .row-icon {
    width: 20px;
    height: 20px;
  }
  .name a {
    color: inherit;
    text-decoration: none;
  }
  .row:hover .name a,
  .row:focus-visible .name a {
    color: var(--accent-2);
  }
  .star {
    color: var(--accent);
  }
  .col-desc {
    color: var(--ink-soft);
  }
  .tech {
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
  }
  .pill {
    font-size: 0.72rem;
    font-weight: 600;
    padding: 3px 9px;
    color: var(--ink-soft);
    background: var(--paper-2);
    border-radius: var(--radius-pill);
    white-space: nowrap;
  }
  .date {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--ink-soft);
    white-space: nowrap;
  }
  .empty {
    padding: 1.5rem 0;
  }

  /* Phones: the table becomes a stack of cards. Sorting still works. */
  @media (max-width: 680px) {
    .explorer,
    .explorer tbody,
    .explorer tr,
    .explorer td {
      display: block;
      width: 100%;
    }
    .explorer thead {
      display: none;
    }
    .row {
      margin-bottom: 10px;
      padding: 14px;
      background: var(--paper);
      border: 1px solid var(--line);
      border-radius: var(--radius-sm);
    }
    .row:hover td,
    .row:focus-visible td,
    .row td {
      padding: 0 0 8px;
      border: none;
      background: transparent;
    }
    .row td:last-child {
      padding-bottom: 0;
    }
    .row:active {
      background: var(--paper-2);
    }
    .explorer td.name {
      display: flex;
      font-size: 1.05rem;
      white-space: normal;
    }
    .col-desc {
      font-size: 0.9rem;
      line-height: 1.55;
    }
    /* Status and date share the last line so the card stays compact. */
    .explorer td:nth-last-child(2),
    .explorer td.date {
      display: inline-block;
      width: auto;
      vertical-align: middle;
    }
    .explorer td:nth-last-child(2) {
      margin-right: 12px;
    }
  }
</style>

<script>
  function initProjectsTable() {
    // ---- Row navigation ----------------------------------------------------
    document.querySelectorAll<HTMLElement>('.row').forEach((row) => {
      if (row.dataset.projectsRowReady) return;
      row.dataset.projectsRowReady = 'true';

      const go = () => {
        const href = row.dataset.href;
        if (href) window.location.href = href;
      };
      row.addEventListener('click', (e) => {
        // Let real link clicks behave normally.
        if ((e.target as HTMLElement).tagName !== 'A') go();
      });
      row.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') go();
      });
    });

    // ---- Column sorting ----------------------------------------------------
    const table = document.getElementById('projects-table');
    const tbody = table?.querySelector('tbody');
    document.querySelectorAll<HTMLButtonElement>('.sort').forEach((btn) => {
      if (btn.dataset.projectsSortReady) return;
      btn.dataset.projectsSortReady = 'true';

      btn.addEventListener('click', () => {
        if (!tbody) return;
        const key = btn.dataset.key!;
        const dir = btn.dataset.dir === 'asc' ? 'desc' : 'asc';
        document.querySelectorAll('.sort').forEach((b) => b.removeAttribute('data-dir'));
        btn.dataset.dir = dir;

        const rows = Array.from(tbody.querySelectorAll<HTMLElement>('.row'));
        rows.sort((a, b) => {
          let av: string | number = '';
          let bv: string | number = '';
          if (key === 'date') {
            av = Number(a.dataset.date);
            bv = Number(b.dataset.date);
          } else {
            av = a.dataset[key] ?? '';
            bv = b.dataset[key] ?? '';
          }
          const cmp = av < bv ? -1 : av > bv ? 1 : 0;
          return dir === 'asc' ? cmp : -cmp;
        });
        rows.forEach((r) => tbody.appendChild(r));
      });
    });
  }

  if (!(window as any).__mrProjectsTable) {
    (window as any).__mrProjectsTable = true;
    document.addEventListener('mr:window-ready', initProjectsTable);
  }
  initProjectsTable();
</script>
