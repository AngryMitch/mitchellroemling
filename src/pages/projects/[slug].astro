---
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import { Image } from 'astro:assets';
import WindowLayout from '../../layouts/WindowLayout.astro';
import Button from '../../components/Button.astro';
import StatusBadge from '../../components/StatusBadge.astro';

export const getStaticPaths = (async () => {
  const items = (
    await getCollection('projects', ({ data }) => !data.draft && !data.hidden)
  ).sort(
    (a, b) => b.data.date.getTime() - a.data.date.getTime(),
  );
  return items.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, prev: items[i - 1] ?? null, next: items[i + 1] ?? null },
  }));
}) satisfies GetStaticPaths;

const { entry, prev, next } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);

const dateStr = data.date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
});
---

<WindowLayout
  title={data.title}
  windowTitle={`${data.title} — Properties`}
  icon="/icons/projects.svg"
  description={data.description}
>
  <article class="project">
    <header class="head">
      <h1 class="title">{data.title}</h1>
      <StatusBadge status={data.status} />
    </header>
    <p class="tagline prose">{data.description}</p>

    {
      data.thumbnail && (
        <figure class="shot bevel-sunken">
          <Image
            src={data.thumbnail}
            alt={`Screenshot of ${data.title}`}
            widths={[480, 800, 1100]}
            sizes="(max-width: 800px) 100vw, 760px"
            class="shot-img"
          />
        </figure>
      )
    }

    <div class="info">
      <div class="info-block">
        <h2 class="ihead font-chrome">Tech stack</h2>
        <ul class="tech">
          {data.tech.map((t) => <li class="pill">{t}</li>)}
        </ul>
      </div>
      <div class="info-block">
        <h2 class="ihead font-chrome">Details</h2>
        <dl class="facts">
          <div><dt>Status</dt><dd>{data.status}</dd></div>
          <div><dt>Updated</dt><dd>{dateStr}</dd></div>
        </dl>
      </div>
    </div>

    <div class="links">
      {data.github && <Button href={data.github}>◧ Source (GitHub)</Button>}
      {data.live && <Button variant="primary" href={data.live}>▶ Live Demo</Button>}
    </div>

    <div class="prose body">
      <Content />
    </div>

    <nav class="pager" aria-label="Project navigation">
      <div class="pager-side">
        {prev && <Button href={`/projects/${prev.id}`}>‹ {prev.data.title}</Button>}
      </div>
      <Button href="/projects">▦ All Projects</Button>
      <div class="pager-side right">
        {next && <Button href={`/projects/${next.id}`}>{next.data.title} ›</Button>}
      </div>
    </nav>
  </article>
</WindowLayout>

<style>
  .project {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }
  .head {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    flex-wrap: wrap;
  }
  .title {
    font-family: var(--font-body);
    font-size: 1.9rem;
    line-height: 1.15;
  }
  .tagline {
    max-width: none;
    color: #333;
    font-size: 1.15rem;
  }
  .shot {
    padding: 8px;
    background: #1a1a1a;
  }
  .shot-img {
    width: 100%;
    height: auto;
  }
  .info {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    padding: 1rem;
    background: #f3f3f3;
    border: 2px solid;
    border-color: var(--win-darker) var(--win-light) var(--win-light)
      var(--win-darker);
  }
  .ihead {
    font-size: 9px;
    color: var(--win-navy);
    margin-bottom: 0.6rem;
  }
  .tech {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    list-style: none;
    padding: 0;
  }
  .pill {
    font-size: 0.8rem;
    padding: 3px 9px;
    background: var(--win-grey);
    border: 2px solid;
    border-color: var(--win-light) var(--win-dark) var(--win-dark) var(--win-light);
  }
  .facts div {
    display: flex;
    gap: 0.5rem;
    padding: 2px 0;
  }
  .facts dt {
    font-family: var(--font-chrome);
    font-size: 8px;
    color: var(--win-navy);
    min-width: 64px;
    text-transform: uppercase;
  }
  .facts dd {
    text-transform: capitalize;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .body:empty {
    display: none;
  }
  .pager {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 8px;
    margin-top: 0.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--win-grey);
  }
  .pager-side {
    display: flex;
  }
  .pager-side.right {
    justify-content: flex-end;
  }
  @media (max-width: 560px) {
    .info {
      grid-template-columns: 1fr;
    }
    .pager {
      grid-template-columns: 1fr;
    }
    .pager-side.right {
      justify-content: flex-start;
    }
  }
</style>
