---
import { getCollection } from 'astro:content';
import WindowLayout from '../../layouts/WindowLayout.astro';
import BlogCard from '../../components/BlogCard.astro';
import MenuBar from '../../components/MenuBar.astro';

const posts = (
  await getCollection('blog', ({ data }) => !data.draft && !data.hidden)
).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
---

<WindowLayout
  title="Blog"
  windowTitle="Blog - My Documents"
  icon="/icons/blog.svg"
  description="Writing about art, code, and the spaces in between."
>
  <MenuBar slot="menubar" />

  <div class="blog">
    <header class="intro">
      <h1 class="font-chrome">My Documents</h1>
      <a class="rss" href="/rss.xml" title="RSS feed">RSS</a>
    </header>

    {
      posts.length === 0 ? (
        <p class="empty prose">
          No posts yet. Add a Markdown file to <code>src/content/blog/</code>.
        </p>
      ) : (
        <div class="list">
          {posts.map((entry) => (
            <BlogCard entry={entry} />
          ))}
        </div>
      )
    }
  </div>

  <Fragment slot="statusbar">
    <span class="status-cell">{posts.length} document(s)</span>
    <span class="status-cell grow">Blog</span>
  </Fragment>
</WindowLayout>

<style>
  .intro {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.25rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--line);
  }
  .intro h1 {
    font-size: 1.5rem;
    font-weight: 800;
  }
  .rss {
    flex: none;
    font-family: var(--font-chrome);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    padding: 7px 14px;
    color: var(--accent-2);
    background: var(--accent-soft);
    border-radius: var(--radius-pill);
    text-decoration: none;
    transition: background var(--transition), color var(--transition);
  }
  .rss:hover {
    background: var(--accent);
    color: #fff;
  }
  .list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .empty {
    padding: 1.5rem 0;
  }
</style>
