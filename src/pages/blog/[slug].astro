---
import { getCollection, getEntries, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import { Image } from 'astro:assets';
import WindowLayout from '../../layouts/WindowLayout.astro';
import Button from '../../components/Button.astro';

export const getStaticPaths = (async () => {
  const items = (
    await getCollection('blog', ({ data }) => !data.draft && !data.hidden)
  ).sort(
    (a, b) => b.data.date.getTime() - a.data.date.getTime(),
  );
  return items.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, prev: items[i - 1] ?? null, next: items[i + 1] ?? null },
  }));
}) satisfies GetStaticPaths;

const { entry, prev, next } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);

// Pull in the referenced artwork pieces (images + metadata).
const related = data.relatedArtwork.length
  ? await getEntries(data.relatedArtwork)
  : [];

const dateStr = data.date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<WindowLayout
  title={data.title}
  windowTitle={`${data.title} - Notepad`}
  icon="/icons/blog.svg"
  description={data.description}
>
  <article class="post">
    <header class="head">
      <p class="meta font-chrome">{dateStr}</p>
      <h1 class="title">{data.title}</h1>
      <p class="lede prose">{data.description}</p>
      {
        data.tags.length > 0 && (
          <ul class="tags">
            {data.tags.map((t) => (
              <li class="tag">#{t}</li>
            ))}
          </ul>
        )
      }
    </header>

    {
      data.cover && (
        <figure class="cover well">
          <Image
            src={data.cover}
            alt=""
            widths={[480, 900, 1200]}
            sizes="(max-width: 800px) 100vw, 760px"
            class="cover-img"
          />
        </figure>
      )
    }

    <div class="prose body">
      <Content />
    </div>

    {
      related.length > 0 && (
        <section class="gallery-strip" aria-label="Featured artwork from this post">
          <h2 class="strip-head font-chrome">Featured artwork</h2>
          <div class="strip-grid">
            {related.map((art) => (
              <a class="strip-item hairline" href={`/gallery/${art.id}`}>
                <span class="strip-frame well">
                  <Image
                    src={art.data.thumbnail ?? art.data.image}
                    alt={art.data.title}
                    width={300}
                    height={300}
                    widths={[150, 300]}
                    sizes="(max-width: 600px) 45vw, 200px"
                    class="strip-img"
                  />
                </span>
                <span class="strip-cap">{art.data.title}</span>
              </a>
            ))}
          </div>
        </section>
      )
    }

    <nav class="pager" aria-label="Post navigation">
      <div class="pager-side">
        {prev && <Button href={`/blog/${prev.id}`}>‹ {prev.data.title}</Button>}
      </div>
      <Button href="/blog">▦ All Posts</Button>
      <div class="pager-side right">
        {next && <Button href={`/blog/${next.id}`}>{next.data.title} ›</Button>}
      </div>
    </nav>
  </article>
</WindowLayout>

<style>
  .post {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .meta {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--ink-soft);
  }
  .title {
    font-family: var(--font-body);
    font-size: 2.1rem;
    font-weight: 800;
    line-height: 1.2;
    margin: 0.5rem 0;
  }
  .lede {
    max-width: none;
    font-size: 1.15rem;
    color: var(--ink-soft);
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    list-style: none;
    padding: 0;
    margin-top: 0.9rem;
  }
  .tag {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--ink-soft);
    padding: 4px 11px;
    background: var(--paper-2);
    border-radius: var(--radius-pill);
  }
  .cover {
    padding: 0;
    overflow: hidden;
    border-radius: var(--radius-sm);
    background: var(--paper-2);
  }
  .cover-img {
    width: 100%;
    height: auto;
  }
  .body {
    max-width: 70ch;
  }
  .gallery-strip {
    margin-top: 1rem;
    padding: 1.25rem;
    background: var(--paper-2);
    border-radius: var(--radius-sm);
  }
  .strip-head {
    font-size: 1rem;
    font-weight: 800;
    margin-bottom: 1rem;
  }
  .strip-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
    gap: 10px;
  }
  .strip-item {
    display: flex;
    flex-direction: column;
    gap: 7px;
    padding: 8px;
    background: var(--paper);
    border: none;
    border-radius: var(--radius-sm);
    text-decoration: none;
    color: var(--ink);
    transition: box-shadow var(--transition), transform var(--transition);
  }
  .strip-item:hover {
    box-shadow: var(--shadow);
  }
  .strip-item:active {
    transform: scale(0.98);
  }
  .strip-frame {
    aspect-ratio: 1;
    overflow: hidden;
    padding: 0;
    border: none;
    border-radius: var(--radius-xs);
    background: var(--paper-2);
  }
  .strip-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .strip-cap {
    font-size: 0.82rem;
    font-weight: 700;
  }
  .pager {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 10px;
    margin-top: 0.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
  }
  .pager-side {
    display: flex;
    min-width: 0;
  }
  .pager-side.right {
    justify-content: flex-end;
  }
  /* Long neighbour titles must not stretch the pager wider than the window. */
  .pager :global(.btn) {
    max-width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    display: inline-block;
    line-height: var(--tap);
    padding-block: 0;
  }
  @media (max-width: 560px) {
    .title {
      font-size: 1.6rem;
    }
    .lede {
      font-size: 1.05rem;
    }
    .gallery-strip {
      padding: 1rem;
    }
    .strip-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .pager {
      grid-template-columns: 1fr;
      gap: 8px;
    }
    .pager-side.right {
      justify-content: flex-start;
    }
    .pager :global(.btn) {
      width: 100%;
      text-align: center;
    }
  }
</style>
