---
import StartMenu from './StartMenu.astro';

/**
 * Fixed bottom taskbar: Start button → StartMenu, one button per open window,
 * and a live clock island on the right.
 *
 * The task buttons are created by desktop.ts as windows open and close, so this
 * renders an empty rail. With JS off there are no windows to track anyway.
 */
---

<footer class="taskbar">
  <button
    id="start-button"
    type="button"
    class="start-btn font-chrome"
    aria-haspopup="menu"
    aria-controls="start-menu"
    aria-expanded="false"
  >
    <img src="/icons/logo.svg" alt="" class="pixelated" width="20" height="20" />
    <span>Start</span>
  </button>

  <div class="divider" aria-hidden="true"></div>

  <div id="task-buttons" class="task-buttons" aria-label="Open windows"></div>

  <div class="tray">
    <time id="taskbar-clock" class="clock font-chrome" datetime="">--:-- --</time>
  </div>

  <StartMenu />
</footer>

<style>
  .taskbar {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 150;
    min-height: var(--taskbar-h);
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 6px 10px;
    padding-bottom: calc(6px + env(safe-area-inset-bottom, 0px));
    /* A floating shelf rather than a bar welded to the bottom edge. */
    border: none;
    border-top: 1px solid var(--line);
    border-radius: 0;
    background: rgba(255, 253, 248, 0.86);
    backdrop-filter: blur(12px) saturate(1.2);
    box-shadow: 0 -6px 24px -18px rgba(120, 96, 60, 0.9);
  }
  .start-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 40px;
    padding: 0 16px 0 12px;
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--ink);
    background: var(--accent-soft);
    border: 1px solid #eccc9f;
    border-radius: var(--radius-pill);
    transition: background var(--transition), transform var(--transition);
  }
  .start-btn img {
    width: 20px;
    height: 20px;
  }
  .start-btn[aria-expanded='true'] {
    background: var(--accent);
    border-color: var(--accent-2);
    color: #fff;
  }
  .start-btn:active {
    transform: scale(0.97);
  }
  .divider {
    display: none;
  }
  .task-buttons {
    flex: 1;
    display: flex;
    gap: 4px;
    min-width: 0;
    overflow: hidden;
  }
  /* :global because desktop.ts creates these chips at runtime, so they never
     carry Astro's scoping attribute. Without it they render unstyled. */
  .task-buttons :global(.task-btn) {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 40px;
    padding: 0 14px;
    max-width: 240px;
    min-width: 0;
    font-family: var(--font-ui);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--ink);
    cursor: pointer;
    text-align: left;
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    background: var(--paper-2);
    transition: background var(--transition), opacity var(--transition);
  }
  .task-buttons :global(.task-btn img) {
    width: 18px;
    height: 18px;
    flex: none;
  }
  /* The focused window's chip is the one wearing the accent. */
  .task-buttons :global(.task-btn.is-focused) {
    background: var(--accent-soft);
    border-color: #eccc9f;
    color: var(--ink);
    opacity: 1;
  }
  /* Minimised: the chip fades back instead of popping out. */
  .task-buttons :global(.task-btn.is-minimized) {
    background: transparent;
    color: var(--ink-soft);
    opacity: 0.7;
  }
  .task-buttons :global(.task-label) {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .tray {
    display: flex;
    align-items: center;
    min-height: 36px;
    padding: 0 14px;
    background: transparent;
    border-color: transparent;
  }
  .clock {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--ink-soft);
    white-space: nowrap;
  }
  /* Narrow phones: the icon in the task chip is enough, keep "Start" readable. */
  @media (max-width: 480px) {
    .task-buttons :global(.task-label) {
      display: none;
    }
    .task-buttons :global(.task-btn) {
      padding: 0 12px;
    }
    .tray {
      padding: 0 6px;
    }
  }
</style>

<script>
  // The taskbar lives in the shell and is never re-rendered, so everything here
  // binds exactly once. Window buttons are desktop.ts's job; this file only owns
  // the Start menu and the clock.

  function closeStartMenu() {
    const btn = document.getElementById('start-button');
    const menu = document.getElementById('start-menu');
    if (!btn || !menu) return;
    btn.setAttribute('aria-expanded', 'false');
    menu.setAttribute('hidden', '');
  }

  function tickClock() {
    const clock = document.getElementById('taskbar-clock') as HTMLTimeElement | null;
    if (!clock) return;
    const now = new Date();
    clock.dateTime = now.toISOString();
    clock.textContent = now.toLocaleTimeString([], {
      hour: 'numeric',
      minute: '2-digit',
      hour12: true,
    });
  }

  // Register the global bits exactly once for the tab.
  if (!(window as any).__mrTaskbar) {
    (window as any).__mrTaskbar = true;

    document.addEventListener('click', (e) => {
      const menu = document.getElementById('start-menu');
      const btn = document.getElementById('start-button');
      if (!menu || menu.hasAttribute('hidden')) return;
      const target = e.target as Node;
      if (!menu.contains(target) && target !== btn && !btn?.contains(target))
        closeStartMenu();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeStartMenu();
    });

    // One interval for the life of the tab; it updates whatever clock is in the DOM.
    window.setInterval(tickClock, 1000 * 15);

    const startBtn = document.getElementById('start-button');
    const startMenu = document.getElementById('start-menu');
    startBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      const open = startBtn.getAttribute('aria-expanded') === 'true';
      startBtn.setAttribute('aria-expanded', String(!open));
      startMenu?.toggleAttribute('hidden', open);
    });
  }

  tickClock();
</script>
