---
import WindowControls from './WindowControls.astro';

/**
 * A bevelled title bar: icon + title text + window controls.
 * `active` styles the bar with the bright accent gradient; inactive bars
 * use a muted grey (matching how Windows dims background windows).
 */
interface Props {
  title: string;
  icon?: string;
  active?: boolean;
  closeHref?: string;
  controls?: boolean;
}
const {
  title,
  icon,
  active = true,
  closeHref = '/',
  controls = true,
} = Astro.props;
---

<div class:list={['title-bar', 'font-chrome', { active }]}>
  <div class="title">
    {icon && <img src={icon} alt="" class="title-icon pixelated" width="16" height="16" />}
    <span class="title-text">{title}</span>
  </div>
  {controls && <WindowControls closeHref={closeHref} />}
</div>

<style>
  .title-bar {
    height: var(--titlebar-h);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding: 3px 4px 3px 6px;
    color: #c5c5c5;
    /* inactive = dim grey gradient */
    background: linear-gradient(90deg, #7a7a7a, #9e9e9e);
    user-select: none;
  }
  .title-bar.active {
    color: #fff;
    /* navy → luna blue gradient = the Win95/XP hybrid look */
    background: linear-gradient(
      90deg,
      var(--win-navy) 0%,
      var(--win-luna-blue) 60%,
      var(--win-navy-2) 100%
    );
  }
  .title {
    display: flex;
    align-items: center;
    gap: 6px;
    min-width: 0;
  }
  .title-icon {
    flex: none;
  }
  .title-text {
    font-size: 10px;
    line-height: 1.2;
    text-shadow: 1px 1px 0 rgba(0, 0, 0, 0.4);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  @media (max-width: 520px) {
    .title-text {
      font-size: 8px;
    }
  }
</style>
