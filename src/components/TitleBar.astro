---
import WindowControls from './WindowControls.astro';

/**
 * A soft title bar: icon + title text + window controls.
 * `active` gives it the warm accent wash; inactive bars stay plain paper
 * (the same way a background window dims on a real desktop).
 */
interface Props {
  title: string;
  icon?: string;
  active?: boolean;
  closeHref?: string;
  controls?: boolean;
}
const {
  title,
  icon,
  active = true,
  closeHref = '/',
  controls = true,
} = Astro.props;
---

<div class:list={['title-bar', 'font-chrome', { active }]}>
  <div class="title">
    {icon && <img src={icon} alt="" class="title-icon pixelated" width="16" height="16" />}
    <span class="title-text">{title}</span>
  </div>
  {controls && <WindowControls closeHref={closeHref} />}
</div>

<style>
  .title-bar {
    min-height: var(--titlebar-h);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 4px 6px 4px 14px;
    border-radius: var(--radius-inner);
    color: var(--ink-soft);
    background: var(--paper-2);
    user-select: none;
  }
  .title-bar.active {
    color: var(--ink);
    background: linear-gradient(180deg, var(--accent-soft) 0%, #ffdfb9 100%);
  }
  .title {
    display: flex;
    align-items: center;
    gap: 9px;
    min-width: 0;
  }
  .title-icon {
    flex: none;
    width: 18px;
    height: 18px;
  }
  .title-text {
    font-size: 0.9rem;
    font-weight: 700;
    line-height: 1.3;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  @media (max-width: 520px) {
    .title-bar {
      padding-left: 10px;
    }
    .title-text {
      font-size: 0.85rem;
    }
  }
</style>
