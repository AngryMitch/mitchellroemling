---
/**
 * A soft pill button. Renders an <a> when `href` is supplied, otherwise a
 * <button>. Default = paper; `primary` = warm accent.
 */
interface Props {
  href?: string;
  type?: 'button' | 'submit' | 'reset';
  variant?: 'default' | 'primary';
  disabled?: boolean;
  class?: string;
  [key: string]: unknown;
}
const {
  href,
  type = 'button',
  variant = 'default',
  disabled = false,
  class: className,
  ...rest
} = Astro.props;

const Tag = href ? 'a' : 'button';
const tagProps = href
  ? { href, ...rest }
  : { type, disabled, ...rest };
---

<Tag class:list={['btn', 'font-chrome', `btn-${variant}`, className]} {...tagProps}>
  <slot />
</Tag>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    min-height: var(--tap);
    padding: 0.6rem 1.15rem;
    font-size: 0.9rem;
    font-weight: 700;
    line-height: 1.2;
    color: var(--ink);
    text-align: center;
    text-decoration: none;
    background: var(--paper);
    border: 1px solid var(--line-2);
    border-radius: var(--radius-pill);
    box-shadow: 0 2px 0 var(--line-2);
    user-select: none;
    transition: transform var(--transition), background var(--transition),
      box-shadow var(--transition);
  }
  .btn:hover {
    background: var(--accent-soft);
    border-color: #eccc9f;
  }
  /* The press is the whole affordance now: it sinks onto its own shadow. */
  .btn:active {
    transform: translateY(2px);
    box-shadow: 0 0 0 var(--line-2);
  }
  .btn-primary {
    color: #fff;
    background: var(--accent);
    border-color: var(--accent-2);
    box-shadow: 0 2px 0 var(--accent-2);
  }
  .btn-primary:hover {
    background: var(--accent-2);
  }
  .btn-primary:active {
    box-shadow: 0 0 0 var(--accent-2);
  }
  .btn[disabled] {
    color: var(--ink-soft);
    background: var(--chrome-2);
    box-shadow: none;
    cursor: not-allowed;
    pointer-events: none;
  }
</style>
