---
import TitleBar from './TitleBar.astro';

/**
 * Static window chrome: a soft rounded card with a title bar and a content
 * body. Use the default slot for the window body. Optional named slots:
 * `menubar` (the little menu strip) and `statusbar` (bottom status row).
 */
interface Props {
  title: string;
  icon?: string;
  closeHref?: string;
  /** Make the body a recessed white "content well". Default true. */
  inset?: boolean;
  /** Constrain the window width; otherwise it fills its container. */
  maxWidth?: string;
  controls?: boolean;
  class?: string;
}
const {
  title,
  icon,
  closeHref = '/',
  inset = true,
  maxWidth,
  controls = true,
  class: className,
} = Astro.props;

const hasMenu = Astro.slots.has('menubar');
const hasStatus = Astro.slots.has('statusbar');
---

<section
  class:list={['window', 'surface', className]}
  style={maxWidth ? `max-width:${maxWidth}` : undefined}
>
  <TitleBar title={title} icon={icon} closeHref={closeHref} controls={controls} />

  {
    hasMenu && (
      <div class="menubar font-chrome">
        <slot name="menubar" />
      </div>
    )
  }

  <div class:list={['window-body', { inset, 'well': inset }]}>
    <slot />
  </div>

  {
    hasStatus && (
      <div class="statusbar">
        <slot name="statusbar" />
      </div>
    )
  }
</section>

<style>
  .window {
    background: var(--chrome);
    padding: 8px;
    display: flex;
    flex-direction: column;
    min-width: 0;
    overflow: hidden;
    transition: transform var(--transition), opacity var(--transition);
  }
  @media (max-width: 640px) {
    .window {
      padding: 6px;
    }
  }
  /* Minimise-to-tray: animate down toward the taskbar, then hide. */
  .window.is-minimizing {
    animation: win-minimize 180ms ease forwards;
    transform-origin: bottom left;
  }
  .window.is-minimized {
    display: none;
  }
  .window.is-restoring {
    animation: win-restore 180ms ease;
    transform-origin: bottom left;
  }
  @keyframes win-minimize {
    to {
      transform: scale(0.2) translateY(60vh);
      opacity: 0;
    }
  }
  @keyframes win-restore {
    from {
      transform: scale(0.2) translateY(60vh);
      opacity: 0;
    }
  }
  .menubar {
    display: flex;
    gap: 2px;
    padding: 4px 2px 2px;
    font-size: 0.8rem;
  }
  .window-body {
    flex: 1;
    margin-top: 6px;
    padding: var(--body-pad, clamp(0.9rem, 4vw, 1.75rem));
    background: var(--paper);
    overflow-wrap: break-word;
  }
  .statusbar {
    display: flex;
    gap: 6px;
    align-items: center;
    margin-top: 6px;
    padding: 0 2px;
    min-width: 0;
  }
  /* Maximised state toggled by the title bar's maximise button. */
  .window.is-maximised {
    position: fixed;
    inset: 8px 8px calc(var(--taskbar-gap) + 8px) 8px;
    max-width: none !important;
    z-index: 50;
    overflow: auto;
    box-shadow: var(--shadow-lift);
  }
</style>
