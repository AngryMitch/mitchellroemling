---
/**
 * The minimise / maximise / close cluster shown at the right of a TitleBar.
 * My windows are static (no real drag/resize), so these are mostly decorative,
 * except Close, which navigates to `closeHref` (defaults to the desktop).
 */
interface Props {
  closeHref?: string;
}
const { closeHref = '/' } = Astro.props;
---

<div class="controls" aria-hidden="false">
  <button type="button" class="ctrl ctrl-min" data-min aria-label="Minimise"
    >–</button
  >
  <button type="button" class="ctrl ctrl-max" data-max aria-label="Maximise"
    >□</button
  >
  <a class="ctrl ctrl-close" href={closeHref} aria-label="Close window">✕</a>
</div>

<style>
  .controls {
    display: flex;
    gap: 6px;
    align-items: center;
  }
  /* Soft pastel dots. The glyph stays faint until you hover, so the chrome
     reads as decoration rather than a row of shouting buttons. */
  .ctrl {
    position: relative;
    width: 22px;
    height: 22px;
    flex: none;
    display: grid;
    place-items: center;
    border: 1px solid rgba(120, 96, 60, 0.16);
    border-radius: 50%;
    font-family: var(--font-chrome);
    font-size: 0.7rem;
    font-weight: 700;
    line-height: 1;
    color: rgba(74, 70, 64, 0);
    text-decoration: none;
    padding: 0;
    transition: color var(--transition), transform var(--transition);
  }
  /* Comfortable tap area without a comically large dot. */
  .ctrl::after {
    content: '';
    position: absolute;
    inset: -8px;
  }
  .ctrl-min {
    background: #f8cd82;
  }
  .ctrl-max {
    background: #a5d8bd;
  }
  .ctrl-close {
    background: #f4aca2;
  }
  .controls:hover .ctrl,
  .ctrl:focus-visible {
    color: rgba(74, 70, 64, 0.65);
  }
  .ctrl:active {
    transform: scale(0.9);
  }
  @media (max-width: 640px) {
    .ctrl {
      width: 24px;
      height: 24px;
    }
    /* No hover on touch, so keep the glyphs legible. */
    .ctrl {
      color: rgba(74, 70, 64, 0.5);
    }
  }
</style>
<script>
  // The minimise button (data-min) is wired up by the Taskbar, which owns the
  // tray button it collapses into. Here we only handle maximise.
  function initWindowControls() {
    document.querySelectorAll<HTMLButtonElement>('[data-max]').forEach((btn) => {
      if (btn.dataset.windowControlsReady) return;
      btn.dataset.windowControlsReady = 'true';
      btn.addEventListener('click', () => {
        btn.closest<HTMLElement>('.window')?.classList.toggle('is-maximised');
      });
    });
  }

  if (!(window as any).__mrWindowControls) {
    (window as any).__mrWindowControls = true;
    document.addEventListener('astro:page-load', initWindowControls);
  }
  initWindowControls();
</script>
