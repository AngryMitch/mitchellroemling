---
import { Image } from 'astro:assets';
import { getEntry } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

/**
 * A blog post preview row. If the post has no cover but references artwork,
 * I use the first related artwork image as the thumbnail, so posts can
 * "pull" artwork photos automatically.
 */
interface Props {
  entry: CollectionEntry<'blog'>;
}
const { entry } = Astro.props;
const { data } = entry;

// Resolve a thumbnail: explicit cover, else first related artwork's image.
let thumb = data.cover ?? null;
if (!thumb && data.relatedArtwork.length > 0) {
  const art = await getEntry(data.relatedArtwork[0]);
  thumb = art?.data.thumbnail ?? art?.data.image ?? null;
}

const dateStr = data.date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
---

<article class="blog-card hairline">
  <a class="link" href={`/blog/${entry.id}`}>
    {
      thumb && (
        <span class="thumb-wrap well">
          <Image
            src={thumb}
            alt=""
            width={240}
            height={160}
            class="thumb"
          />
        </span>
      )
    }
    <span class="body">
      <span class="meta font-chrome">{dateStr}</span>
      <h3 class="title">{data.title}</h3>
      <p class="desc">{data.description}</p>
      {
        data.tags.length > 0 && (
          <span class="tags">
            {data.tags.map((t) => (
              <span class="tag">#{t}</span>
            ))}
          </span>
        )
      }
    </span>
  </a>
</article>

<style>
  .blog-card {
    background: var(--paper);
    overflow: hidden;
    transition: border-color var(--transition), box-shadow var(--transition),
      transform var(--transition);
  }
  .link {
    display: flex;
    gap: 16px;
    padding: 14px;
    text-decoration: none;
    color: var(--ink);
    align-items: flex-start;
  }
  .blog-card:hover {
    border-color: var(--line-2);
    box-shadow: var(--shadow);
  }
  .blog-card:active {
    transform: scale(0.995);
  }
  .thumb-wrap {
    flex: none;
    width: 150px;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    padding: 0;
    border-radius: var(--radius-xs);
    background: var(--paper-2);
  }
  .thumb {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .body {
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-width: 0;
  }
  .meta {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--ink-soft);
  }
  .title {
    font-family: var(--font-body);
    font-size: 1.25rem;
    font-weight: 800;
    line-height: 1.25;
  }
  .link:hover .title {
    color: var(--accent-2);
  }
  .desc {
    font-family: var(--font-body);
    color: var(--ink-soft);
    line-height: 1.6;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 4px;
  }
  .tag {
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--ink-soft);
    background: var(--paper-2);
    border-radius: var(--radius-pill);
    padding: 2px 9px;
  }
  /* Phones: stack the thumbnail above the text so the title gets full width. */
  @media (max-width: 540px) {
    .link {
      flex-direction: column;
      gap: 12px;
      padding: 12px;
    }
    .thumb-wrap {
      width: 100%;
      aspect-ratio: 16 / 9;
    }
    .title {
      font-size: 1.15rem;
    }
    .desc {
      font-size: 0.95rem;
    }
  }
</style>
