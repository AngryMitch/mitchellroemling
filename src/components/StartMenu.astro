---
import { NAV_ITEMS, SITE, SOCIAL_LINKS } from '../consts';

/**
 * The Start Menu panel. Hidden by default; toggled by the Start button in
 * the Taskbar (see Taskbar.astro's script). The vertical brand strip on the
 * left is a nod to the classic Win95 sidebar, in a warmer key.
 */
const pathname = Astro.url.pathname;
const isActive = (match: string) =>
  pathname === match || pathname.startsWith(match + '/');
---

<div id="start-menu" class="start-menu surface" hidden>
  <div class="brand-strip" aria-hidden="true">
    <span class="brand-name font-chrome">{SITE.name}</span>
  </div>
  <nav class="menu-items" aria-label="Start menu">
    <a class="item" href="/">
      <img src="/icons/computer.svg" alt="" class="pixelated" width="24" height="24" />
      <span>Home (Desktop)</span>
    </a>
    <hr />
    {
      NAV_ITEMS.map((n) => (
        <a class:list={['item', { active: isActive(n.match) }]} href={n.href}>
          <img src={`/icons/${n.icon}.svg`} alt="" class="pixelated" width="24" height="24" />
          <span>{n.label}</span>
        </a>
      ))
    }
    <hr />
    {
      SOCIAL_LINKS.map((s) => (
        <a class="item small" href={s.href} rel="me noopener">
          <img src={`/icons/${s.icon}.svg`} alt="" class="pixelated" width="20" height="20" />
          <span>{s.label}</span>
        </a>
      ))
    }
  </nav>
</div>

<style>
  .start-menu {
    position: absolute;
    bottom: calc(100% + 6px);
    left: 10px;
    z-index: 200;
    display: flex;
    overflow: hidden;
    width: min(320px, calc(100vw - 20px));
    max-height: min(70vh, 560px);
    background: var(--paper);
    box-shadow: var(--shadow-lift);
    animation: menu-in 160ms cubic-bezier(0.32, 0.72, 0.35, 1);
  }
  @keyframes menu-in {
    from {
      transform: translateY(10px);
      opacity: 0;
    }
  }
  .start-menu[hidden] {
    display: none;
  }
  .brand-strip {
    width: 34px;
    flex: none;
    background: linear-gradient(180deg, #ffd7a6, var(--accent));
    display: flex;
    align-items: flex-end;
    justify-content: center;
    padding: 12px 0;
  }
  .brand-name {
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    color: #fff;
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    white-space: nowrap;
  }
  .menu-items {
    flex: 1;
    display: flex;
    flex-direction: column;
    padding: 8px;
    min-width: 0;
    overflow-y: auto;
  }
  .item {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: var(--tap);
    padding: 8px 12px;
    border-radius: var(--radius-sm);
    text-decoration: none;
    color: var(--ink);
    font-family: var(--font-ui);
    font-weight: 600;
    font-size: 0.95rem;
    transition: background var(--transition);
  }
  .item img {
    width: 24px;
    height: 24px;
    flex: none;
  }
  .item.small {
    min-height: 40px;
    font-size: 0.88rem;
    font-weight: 400;
    color: var(--ink-soft);
  }
  .item.small img {
    width: 20px;
    height: 20px;
  }
  .item:hover,
  .item:focus-visible {
    background: var(--accent-soft);
    color: var(--ink);
    outline: none;
  }
  .item.active {
    background: var(--paper-2);
    color: var(--accent-2);
  }
  .menu-items hr {
    border: none;
    border-top: 1px solid var(--line);
    margin: 6px 4px;
  }
</style>
