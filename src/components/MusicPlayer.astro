---
import { PLAYLIST, youtubeEmbedUrl } from '../music';

/**
 * My always-on music player: a YouTube (no-cookie) embed framed in a little
 * window, docked bottom-right. It lives in BaseLayout (so it's on every
 * page) and uses `transition:persist` so the audio keeps playing as I browse,
 * once the visitor hits play (browsers won't autoplay sound on their own).
 *
 * Tracks come from src/music.ts. With more than one, a menu lets you switch.
 */
const first = PLAYLIST[0];
const firstUrl = first ? youtubeEmbedUrl(first.id) : '';
const hasMusic = PLAYLIST.length > 0;
---

{
  hasMusic && (
    <section
      class="mp surface"
      transition:persist="site-music"
      data-collapsed="false"
      aria-label="Music player"
    >
      <div class="mp-title font-chrome">
        <span class="mp-name">♪ Music</span>
        <button
          type="button"
          class="mp-toggle"
          data-mp-toggle
          aria-label="Collapse or expand the music player"
        >
          <span class="mp-chevron" aria-hidden="true" />
        </button>
      </div>
      <div class="mp-body">
        {PLAYLIST.length > 1 && (
          /* A listbox rather than a <select>: browsers render a native select's
             popup themselves, so its options cannot be styled at all. This is
             the only way the list can match the rest of the chrome. */
          <div class="mp-picker" data-mp-picker>
            <button
              type="button"
              class="mp-trigger"
              data-mp-trigger
              aria-haspopup="listbox"
              aria-expanded="false"
              aria-label="Choose a track"
            >
              <span class="mp-current" data-mp-current>{first.label}</span>
              <span class="mp-caret" aria-hidden="true" />
            </button>
            <ul class="mp-list" role="listbox" aria-label="Tracks" data-mp-list hidden>
              {PLAYLIST.map((t, i) => (
                <li
                  id={`mp-opt-${t.id}`}
                  class="mp-option"
                  role="option"
                  tabindex="-1"
                  data-id={t.id}
                  aria-selected={i === 0 ? 'true' : 'false'}
                >
                  <span class="mp-tick" aria-hidden="true">♪</span>
                  <span class="mp-option-label">{t.label}</span>
                </li>
              ))}
            </ul>
          </div>
        )}
        <iframe
          data-mp-frame
          class="mp-frame"
          src={firstUrl}
          width="100%"
          height="180"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          referrerpolicy="strict-origin-when-cross-origin"
          loading="lazy"
          allowfullscreen
          title="YouTube music player"
        />
      </div>
    </section>
  )
}

<style>
  .mp {
    position: fixed;
    right: 10px;
    bottom: calc(var(--taskbar-gap) + 10px);
    z-index: 140;
    width: min(320px, calc(100vw - 20px));
    padding: 6px;
    transition: width var(--transition);
  }
  .mp-title {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    min-height: 34px;
    padding: 0 4px 0 12px;
    border-radius: var(--radius-inner);
    color: var(--ink);
    background: linear-gradient(180deg, var(--accent-soft) 0%, #ffdfb9 100%);
  }
  .mp-name {
    font-size: 0.82rem;
    font-weight: 700;
    white-space: nowrap;
  }
  .mp-toggle {
    width: 30px;
    height: 30px;
    flex: none;
    display: grid;
    place-items: center;
    background: transparent;
    border: none;
    border-radius: 50%;
    padding: 0;
  }
  .mp-toggle:hover {
    background: rgba(255, 255, 255, 0.5);
  }
  /* A chevron rather than a minimise underscore; it flips when collapsed. */
  .mp-chevron {
    width: 8px;
    height: 8px;
    border-right: 2px solid var(--ink);
    border-bottom: 2px solid var(--ink);
    transform: translateY(-2px) rotate(45deg);
    transition: transform var(--transition);
  }
  .mp[data-collapsed='true'] .mp-chevron {
    transform: translateY(2px) rotate(-135deg);
  }
  .mp-body {
    margin-top: 6px;
  }
  .mp[data-collapsed='true'] .mp-body {
    display: none;
  }
  .mp[data-collapsed='true'] {
    width: auto;
  }
  /* ---- Track picker (custom listbox) ---- */
  .mp-picker {
    position: relative;
    margin-bottom: 6px;
  }
  .mp-trigger {
    display: flex;
    align-items: center;
    gap: 10px;
    width: 100%;
    min-height: 40px;
    padding: 8px 13px;
    font-family: var(--font-ui);
    font-size: 0.85rem;
    font-weight: 600;
    line-height: 1.3;
    text-align: left;
    color: var(--ink);
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius-xs);
    transition: background var(--transition), border-color var(--transition);
  }
  .mp-trigger:hover {
    background: var(--accent-soft);
    border-color: #eccc9f;
  }
  .mp-current {
    flex: 1;
    min-width: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .mp-caret {
    flex: none;
    width: 8px;
    height: 8px;
    border-right: 2px solid var(--ink-soft);
    border-bottom: 2px solid var(--ink-soft);
    transform: translateY(-2px) rotate(45deg);
    transition: transform var(--transition);
  }
  .mp-trigger[aria-expanded='true'] .mp-caret {
    transform: translateY(2px) rotate(-135deg);
  }

  .mp-list {
    position: absolute;
    left: 0;
    right: 0;
    /* Opens upward: the player is docked to the bottom of the screen. */
    bottom: calc(100% + 6px);
    z-index: 5;
    margin: 0;
    padding: 6px;
    list-style: none;
    max-height: 46vh;
    overflow-y: auto;
    overscroll-behavior: contain;
    background: var(--paper);
    border: 1px solid var(--line-2);
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow-lift);
    animation: mp-list-in 140ms cubic-bezier(0.32, 0.72, 0.35, 1);
  }
  .mp-list[hidden] {
    display: none;
  }
  @keyframes mp-list-in {
    from {
      transform: translateY(6px);
      opacity: 0;
    }
  }
  .mp-option {
    display: flex;
    align-items: center;
    gap: 9px;
    padding: 9px 11px;
    border-radius: var(--radius-xs);
    font-size: 0.85rem;
    font-weight: 600;
    line-height: 1.35;
    color: var(--ink);
    cursor: pointer;
    transition: background var(--transition), color var(--transition);
  }
  .mp-option:hover,
  .mp-option:focus-visible {
    background: var(--accent-soft);
    outline: none;
  }
  .mp-option[aria-selected='true'] {
    background: var(--accent);
    color: #fff;
  }
  .mp-tick {
    flex: none;
    width: 1em;
    font-size: 0.8rem;
    opacity: 0;
  }
  .mp-option[aria-selected='true'] .mp-tick {
    opacity: 1;
  }
  .mp-option-label {
    flex: 1;
    min-width: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .mp-list {
      animation: none;
    }
  }
  .mp-frame {
    display: block;
    width: 100%;
    border: 0;
    border-radius: var(--radius-xs);
    overflow: hidden;
    background: #211d18;
  }

  @media (max-width: 640px) {
    .mp {
      right: 8px;
      bottom: calc(var(--taskbar-gap) + 8px);
      width: min(300px, calc(100vw - 16px));
    }
  }
</style>

<script>
  // The player persists across navigation (transition:persist), so I only wire
  // it up once. The element and its listeners carry over between pages.
  const player = document.querySelector<HTMLElement>('.mp');
  if (player && !player.dataset.mpReady) {
    player.dataset.mpReady = 'true';

    const toggle = player.querySelector<HTMLButtonElement>('[data-mp-toggle]');
    const frame = player.querySelector<HTMLIFrameElement>('[data-mp-frame]');
    const picker = player.querySelector<HTMLElement>('[data-mp-picker]');
    const trigger = player.querySelector<HTMLButtonElement>('[data-mp-trigger]');
    const list = player.querySelector<HTMLElement>('[data-mp-list]');
    const current = player.querySelector<HTMLElement>('[data-mp-current]');
    const options = list
      ? Array.from(list.querySelectorAll<HTMLElement>('[role="option"]'))
      : [];
    const ids = options.map((o) => o.dataset.id ?? '');
    const embed = (id: string) => {
      const params = new URLSearchParams({
        controls: '1',
        rel: '0',
        modestbranding: '1',
        loop: '1',
        playlist: id,
      });
      return `https://www.youtube-nocookie.com/embed/${id}?${params.toString()}`;
    };

    // Restore the collapsed state from a previous full page load. On phones
    // it starts collapsed, so a 180px video never lands on top of the page.
    const savedCollapsed = localStorage.getItem('mr:mp-collapsed');
    const collapseByDefault = window.matchMedia('(max-width: 768px)').matches;
    if (savedCollapsed === 'true' || (savedCollapsed === null && collapseByDefault)) {
      player.dataset.collapsed = 'true';
    }
    toggle?.addEventListener('click', () => {
      const collapsed = player.dataset.collapsed === 'true';
      player.dataset.collapsed = String(!collapsed);
      localStorage.setItem('mr:mp-collapsed', String(!collapsed));
    });

    // Which track to open on, in order of preference:
    //   1. whatever was playing in this browsing session (survives a refresh)
    //   2. the visitor's last explicit pick from the menu
    //   3. a random track, for a genuinely first-time visitor
    //
    // (1) matters because a reload is exactly when someone least wants the song
    // swapped out from under them. Only (3) is a shuffle, and it happens once.
    /** Mark a track as current. `load` is false during boot, when the server
     *  already rendered the right embed and reloading it would restart it. */
    function selectTrack(id: string, { load = true } = {}) {
      const opt = options.find((o) => o.dataset.id === id);
      if (!opt) return;
      options.forEach((o) => o.setAttribute('aria-selected', String(o === opt)));
      if (current) {
        current.textContent = opt.querySelector('.mp-option-label')?.textContent ?? '';
      }
      sessionStorage.setItem('mr:mp-track', id);
      if (load && frame) frame.src = embed(id);
    }

    if (options.length && frame) {
      const valid = (id: string | null): id is string => !!id && ids.includes(id);
      const playing = sessionStorage.getItem('mr:mp-track');
      const chosen = localStorage.getItem('mr:mp-track');
      const startId = valid(playing)
        ? playing
        : valid(chosen)
          ? chosen
          : ids[Math.floor(Math.random() * ids.length)];

      // ids[0] is already in the iframe from the server render.
      if (startId) selectTrack(startId, { load: startId !== ids[0] });
    }

    /* ---- Listbox behaviour ---- */
    const isOpen = () => trigger?.getAttribute('aria-expanded') === 'true';

    function openList() {
      if (!list || !trigger) return;
      list.hidden = false;
      trigger.setAttribute('aria-expanded', 'true');
      const selected = options.find((o) => o.getAttribute('aria-selected') === 'true');
      (selected ?? options[0])?.focus();
      selected?.scrollIntoView({ block: 'nearest' });
    }

    function closeList({ refocus = false } = {}) {
      if (!list || !trigger) return;
      list.hidden = true;
      trigger.setAttribute('aria-expanded', 'false');
      if (refocus) trigger.focus();
    }

    function commit(opt: HTMLElement) {
      const id = opt.dataset.id;
      if (!id) return;
      selectTrack(id);
      localStorage.setItem('mr:mp-track', id); // an explicit pick, so remember it
      closeList({ refocus: true });
    }

    trigger?.addEventListener('click', (e) => {
      e.stopPropagation();
      isOpen() ? closeList() : openList();
    });

    options.forEach((opt, i) => {
      opt.addEventListener('click', () => commit(opt));
      opt.addEventListener('keydown', (e) => {
        const key = (e as KeyboardEvent).key;
        if (key === 'Enter' || key === ' ') {
          e.preventDefault();
          commit(opt);
        } else if (key === 'ArrowDown' || key === 'ArrowUp') {
          e.preventDefault();
          const next = key === 'ArrowDown' ? i + 1 : i - 1;
          options[(next + options.length) % options.length]?.focus();
        } else if (key === 'Home' || key === 'End') {
          e.preventDefault();
          (key === 'Home' ? options[0] : options[options.length - 1])?.focus();
        } else if (key === 'Escape') {
          e.preventDefault();
          closeList({ refocus: true });
        }
      });
    });

    document.addEventListener('click', (e) => {
      if (isOpen() && !picker?.contains(e.target as Node)) closeList();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isOpen()) closeList({ refocus: true });
    });
  }
</script>
