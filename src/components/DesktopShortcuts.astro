---
import DesktopIcon from './DesktopIcon.astro';
import { NAV_ITEMS } from '../consts';

const shortcuts = [
  ...NAV_ITEMS.map((n) => ({ href: n.href, icon: n.icon, label: n.label })),
  { href: '/recycle-bin', icon: 'recycle', label: 'Recycle Bin' },
  { href: '/family', icon: 'family-locked', label: '.family' },
];
---

<nav class="desktop-shortcuts" aria-label="Desktop shortcuts">
  {shortcuts.map((i) => <DesktopIcon href={i.href} icon={i.icon} label={i.label} />)}
</nav>

<style>
  .desktop-shortcuts {
    position: fixed;
    left: 1.25rem;
    bottom: calc(var(--taskbar-gap) + 1.25rem);
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(2, 96px);
    gap: 6px;
    align-content: start;
  }

  /* BaseLayout drops these into the page flow at this width; see its
     `.app.is-desktop` block. Two comfortable columns of cards. */
  @media (max-width: 768px) {
    .desktop-shortcuts {
      grid-template-columns: repeat(2, 1fr);
      gap: 8px;
      width: 100%;
      padding-inline: clamp(0.625rem, 3vw, 2rem);
    }
  }

  @media (max-width: 380px) {
    .desktop-shortcuts {
      grid-template-columns: 1fr;
    }
  }
</style>
