---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

/**
 * A single artwork shown as a soft tile: rounded thumbnail + title + type.
 * Links to the artwork's detail page.
 */
interface Props {
  entry: CollectionEntry<'artwork'>;
}
const { entry } = Astro.props;
const { data } = entry;
const thumb = data.thumbnail ?? data.image;
---

<a class="art-card" href={`/gallery/${entry.id}`} data-type={data.type}>
  <span class="frame well">
    <Image
      src={thumb}
      alt={data.title}
      width={320}
      height={320}
      widths={[160, 320]}
      sizes="(max-width: 600px) 45vw, 200px"
      class="thumb"
    />
  </span>
  <span class="caption font-chrome">{data.title}</span>
  <span class="type-tag">{data.type}</span>
</a>

<style>
  .art-card {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 8px;
    border-radius: var(--radius-sm);
    text-decoration: none;
    color: var(--ink);
    transition: background var(--transition), transform var(--transition);
  }
  .art-card:hover,
  .art-card:focus-visible {
    background: var(--paper-2);
  }
  .art-card:active {
    transform: scale(0.98);
  }
  .frame {
    width: 100%;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: var(--radius-sm);
    background: var(--paper-2);
    padding: 0;
    transition: box-shadow var(--transition);
  }
  .art-card:hover .frame {
    box-shadow: var(--shadow);
  }
  .thumb {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .caption {
    font-size: 0.85rem;
    font-weight: 700;
    line-height: 1.35;
    max-width: 100%;
  }
  .type-tag {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--ink-soft);
    text-transform: capitalize;
    margin-top: -4px;
  }
</style>
