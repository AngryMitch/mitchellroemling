---
/**
 * A desktop icon: pixel-art image + label, links to a section.
 * On phones it stops being a wallpaper icon and becomes a tappable card
 * (see the mobile block below), because a 92px column is not a tap target.
 */
interface Props {
  href: string;
  icon: string; // path under /icons/
  label: string;
}
const { href, icon, label } = Astro.props;
---

<a class="desktop-icon" href={href}>
  <span class="icon-img">
    <img src={`/icons/${icon}.svg`} alt="" class="pixelated" width="40" height="40" />
  </span>
  <span class="icon-label font-chrome">{label}</span>
</a>

<style>
  .desktop-icon {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    width: 96px;
    padding: 10px 6px;
    border-radius: var(--radius-sm);
    text-decoration: none;
    color: var(--ink);
    text-align: center;
    transition: background var(--transition), transform var(--transition);
  }
  .icon-img {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: var(--radius-sm);
    background: rgba(255, 253, 248, 0.72);
    box-shadow: 0 1px 2px rgba(120, 96, 60, 0.1);
    transition: transform var(--transition), box-shadow var(--transition);
  }
  .icon-img img {
    width: 34px;
    height: 34px;
  }
  .desktop-icon:hover .icon-img,
  .desktop-icon:focus-visible .icon-img {
    transform: translateY(-2px);
    box-shadow: var(--shadow);
  }
  .icon-label {
    font-size: 0.78rem;
    font-weight: 700;
    line-height: 1.35;
    padding: 2px 6px;
    border-radius: var(--radius-pill);
  }
  .desktop-icon:hover .icon-label,
  .desktop-icon:focus-visible .icon-label {
    background: var(--accent-soft);
  }

  /* Phones: a row of proper tappable cards instead of a wallpaper grid. */
  @media (max-width: 768px) {
    .desktop-icon {
      flex-direction: row;
      width: 100%;
      min-height: var(--tap);
      gap: 12px;
      justify-content: flex-start;
      padding: 10px;
      background: rgba(255, 253, 248, 0.8);
      border: 1px solid var(--line);
      box-shadow: 0 1px 2px rgba(120, 96, 60, 0.08);
    }
    .desktop-icon:active {
      transform: scale(0.98);
      background: var(--accent-soft);
    }
    .icon-img {
      width: 38px;
      height: 38px;
      flex: none;
      background: transparent;
      box-shadow: none;
    }
    .icon-img img {
      width: 28px;
      height: 28px;
    }
    .icon-label {
      font-size: 0.9rem;
      padding: 0;
      text-align: left;
    }
  }
</style>
