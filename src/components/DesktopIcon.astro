---
/**
 * A desktop icon: 32x32 pixel-art image + label, links to a section.
 * Double-clickable feel via a focus/hover highlight on the label.
 */
interface Props {
  href: string;
  icon: string; // path under /icons/
  label: string;
}
const { href, icon, label } = Astro.props;
---

<a class="desktop-icon" href={href}>
  <span class="icon-img">
    <img src={`/icons/${icon}.svg`} alt="" class="pixelated" width="40" height="40" />
  </span>
  <span class="icon-label font-chrome">{label}</span>
</a>

<style>
  .desktop-icon {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    width: 92px;
    padding: 6px 4px;
    text-decoration: none;
    color: #fff;
    text-align: center;
  }
  .icon-img {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
  }
  .desktop-icon:hover .icon-img img,
  .desktop-icon:focus-visible .icon-img img {
    filter: drop-shadow(0 0 0 #1f6fbf) brightness(1.08);
  }
  .icon-label {
    font-size: 9px;
    line-height: 1.4;
    padding: 2px 4px;
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.9);
  }
  .desktop-icon:hover .icon-label,
  .desktop-icon:focus-visible .icon-label {
    background: var(--win-selection);
    color: var(--win-selection-text);
    outline: 1px dotted #fff;
    text-shadow: none;
  }
  @media (max-width: 640px) {
    .desktop-icon {
      flex-direction: row;
      width: 100%;
      gap: 14px;
      justify-content: flex-start;
      padding: 10px 12px;
    }
    .icon-label {
      font-size: 11px;
    }
  }
</style>
