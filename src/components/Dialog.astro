---
/**
 * A modal dialog box. Hidden by default.
 *
 * Open it from anywhere with a trigger:
 *   <button data-open-dialog="my-dialog">…</button>
 * Close via the OK button, the title-bar ✕, a backdrop click, or Escape.
 *
 * `variant` picks the little icon glyph next to the message:
 *   question (?) · info (i) · warning (!) · none
 */
interface Props {
  id: string;
  title: string;
  variant?: 'question' | 'info' | 'warning' | 'none';
}
const { id, title, variant = 'question' } = Astro.props;

const glyphs = { question: '?', info: 'i', warning: '!', none: '' } as const;
const glyph = glyphs[variant];
---

<div class="dialog-overlay" id={id} hidden>
  <div
    class="dialog surface"
    role="alertdialog"
    aria-modal="true"
    aria-labelledby={`${id}-title`}
    aria-describedby={`${id}-body`}
  >
    <div class="dialog-title font-chrome">
      <span id={`${id}-title`} class="dt-text">{title}</span>
      <button class="dt-close" data-close-dialog aria-label="Close">✕</button>
    </div>
    <div class="dialog-content">
      {glyph && <span class:list={['dlg-icon', `is-${variant}`]} aria-hidden="true">{glyph}</span>}
      <div id={`${id}-body`} class="dialog-body">
        <slot />
      </div>
    </div>
    <div class="dialog-actions">
      <button class="dlg-btn" data-close-dialog autofocus>OK</button>
    </div>
  </div>
</div>

<style>
  .dialog-overlay {
    position: fixed;
    inset: 0;
    z-index: 500;
    display: grid;
    place-items: center;
    padding: 1rem;
    background: rgba(74, 60, 40, 0.28);
    backdrop-filter: blur(2px);
  }
  .dialog-overlay[hidden] {
    display: none;
  }
  .dialog {
    width: min(400px, 92vw);
    background: var(--chrome);
    padding: 8px;
    box-shadow: var(--shadow-lift);
    animation: dlg-in 180ms cubic-bezier(0.32, 0.72, 0.35, 1);
  }
  @keyframes dlg-in {
    from {
      transform: translateY(8px) scale(0.96);
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .dialog {
      animation: none;
    }
  }
  .dialog-title {
    min-height: var(--titlebar-h);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 4px 6px 4px 14px;
    border-radius: var(--radius-inner);
    color: var(--ink);
    background: linear-gradient(180deg, var(--accent-soft) 0%, #ffdfb9 100%);
  }
  .dt-text {
    font-size: 0.9rem;
    font-weight: 700;
  }
  .dt-close {
    width: 22px;
    height: 22px;
    flex: none;
    display: grid;
    place-items: center;
    font-size: 0.7rem;
    font-weight: 700;
    color: rgba(74, 70, 64, 0.55);
    background: #f4aca2;
    border: 1px solid rgba(120, 96, 60, 0.16);
    border-radius: 50%;
    padding: 0;
  }
  .dt-close:active {
    transform: scale(0.9);
  }
  .dialog-content {
    display: flex;
    gap: 16px;
    align-items: flex-start;
    background: var(--paper);
    border-radius: var(--radius-sm);
    margin-top: 6px;
    padding: 20px 18px;
  }
  .dlg-icon {
    flex: none;
    width: 38px;
    height: 38px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    font-family: var(--font-chrome);
    font-size: 1.25rem;
    font-weight: 800;
    color: #fff;
    background: var(--sky);
  }
  .dlg-icon.is-warning {
    background: #f3c164;
    color: var(--ink);
  }
  .dlg-icon.is-info {
    background: var(--accent);
  }
  .dialog-body {
    font-family: var(--font-body);
    font-size: 1rem;
    line-height: 1.6;
    color: var(--ink);
  }
  .dialog-body :global(p) {
    margin: 0 0 0.5rem;
  }
  .dialog-body :global(p:last-child) {
    margin-bottom: 0;
  }
  .dialog-body :global(a) {
    color: var(--accent-2);
    font-weight: 700;
  }
  .dialog-actions {
    display: flex;
    justify-content: center;
    gap: 8px;
    padding: 10px 2px 2px;
  }
  .dlg-btn {
    min-width: 120px;
    min-height: var(--tap);
    padding: 0.6rem 1.25rem;
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--ink);
    background: var(--paper);
    border: 1px solid var(--line-2);
    border-radius: var(--radius-pill);
    box-shadow: 0 2px 0 var(--line-2);
    transition: transform var(--transition), background var(--transition),
      box-shadow var(--transition);
  }
  .dlg-btn:hover {
    background: var(--accent-soft);
  }
  .dlg-btn:active {
    transform: translateY(2px);
    box-shadow: 0 0 0 var(--line-2);
  }
</style>

<script>
  // Delegated, runs once per page (Astro dedupes identical component scripts).
  function closeDialog(overlay: HTMLElement) {
    overlay.hidden = true;
    const opener = document.querySelector<HTMLElement>('[data-dialog-opener]');
    opener?.removeAttribute('data-dialog-opener');
    opener?.focus();
  }

  if (!(window as any).__mrDialog) {
    (window as any).__mrDialog = true;

    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;

      const opener = target.closest<HTMLElement>('[data-open-dialog]');
      if (opener) {
        const id = opener.getAttribute('data-open-dialog');
        const overlay = id && document.getElementById(id);
        if (overlay) {
          opener.setAttribute('data-dialog-opener', '');
          overlay.hidden = false;
          overlay.querySelector<HTMLElement>('[autofocus]')?.focus();
        }
        return;
      }

      if (target.closest('[data-close-dialog]')) {
        const overlay = target.closest<HTMLElement>('.dialog-overlay');
        if (overlay) closeDialog(overlay);
        return;
      }

      // Backdrop click closes.
      if (target.classList.contains('dialog-overlay')) {
        closeDialog(target);
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') return;
      document
        .querySelectorAll<HTMLElement>('.dialog-overlay:not([hidden])')
        .forEach((overlay) => closeDialog(overlay));
    });
  }
</script>
